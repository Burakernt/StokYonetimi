@{
    ViewData["Title"] = "Tedarikçi Tanýmlarý";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style scoped>

    .brutalist-card {
        width: 420px;
        border: 1px solid #000;
        background-color: #fff;
        padding: 1.5rem;
        box-shadow: 2px 2px 0 #000;
    }

    .brutalist-card__header {
        display: flex;
        align-items: center;
        gap: 1rem;
        margin-bottom: 1rem;
        border-bottom: 2px solid #000;
        padding-bottom: 1rem;
    }

    .brutalist-card__icon {
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background-color: #000;
        padding: 0.5rem;
    }

        .brutalist-card__icon svg {
            height: 1.5rem;
            width: 1.5rem;
            fill: #fff;
        }

    .brutalist-card__alert {
        font-weight: 900;
        color: #000;
        font-size: 1.5rem;
        text-transform: uppercase;
    }

    .brutalist-card__message {
        margin-top: 1rem;
        color: #000;
        font-size: 0.9rem;
        line-height: 1.4;
        border-bottom: 2px solid #000;
        padding-bottom: 1rem;
        font-weight: 600;
    }

    .brutalist-card__actions {
        margin-top: 1rem;
    }

    .brutalist-card__button {
        display: block;
        width: 100%;
        padding: 0.75rem;
        text-align: center;
        font-size: 1rem;
        font-weight: 700;
        text-transform: uppercase;
        border: 3px solid #000;
        background-color: #fff;
        color: #000;
        position: relative;
        transition: all 0.2s ease;
        box-shadow: 5px 5px 0 #000;
        overflow: hidden;
        text-decoration: none;
        margin-bottom: 1rem;
    }

    .brutalist-card__button--read {
        background-color: #000;
        color: #fff;
    }

    .brutalist-card__button::before {
        content: "";
        position: absolute;
        top: 0;
        left: -100%;
        width: 100%;
        height: 100%;
        background: linear-gradient( 120deg, transparent, rgba(255, 255, 255, 0.3), transparent );
        transition: all 0.6s;
    }

    .brutalist-card__button:hover::before {
        left: 100%;
    }

    .brutalist-card__button:hover {
        transform: translate(-2px, -2px);
        box-shadow: 7px 7px 0 #000;
    }

    .brutalist-card__button--mark:hover {
        background-color: #296fbb;
        border-color: #296fbb;
        color: #fff;
        box-shadow: 7px 7px 0 #004280;
    }

    .brutalist-card__button--read:hover {
        background-color: #ff0000;
        border-color: #ff0000;
        color: #fff;
        box-shadow: 7px 7px 0 #800000;
    }

    .brutalist-card__button:active {
        transform: translate(5px, 5px);
        box-shadow: none;
    }

    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
        padding: 1rem;
    }

    .table-responsive {
        border-top: 1px solid #e9ecef;
    }

    .table th,
    .table td {
        vertical-align: middle;
    }

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */
    .card {
        border: 0.5px solid gainsboro;
        position: relative;
    }

    
</style>

<div id="supplierApp" class="container py-4" v-cloak>
    <h2>@ViewData["Title"]</h2>
    <hr>

    <!-- Arama ve Yeni Butonu -->
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <div class="input-group">
                <span class="input-group-text bg-white border-dark">
                    <i class="mdi mdi-magnify"></i>
                </span>
                <input type="text"
                       class="form-control form-control-sm border-dark"
                       v-model="searchQuery"
                       placeholder="Tedarikçi ara..."
                       v-on:keyup.enter="searchSuppliers">
                <button class="btn btn-outline-dark btn-sm" v-on:click="searchSuppliers">
                    Ara
                </button>
            </div>
        </div>
        <div class="col-md-6 text-end">
            <button class="btn btn-dark" v-on:click="showCreateForm">
                <i class="mdi mdi-plus"></i> Yeni Tedarikçi
            </button>
        </div>
    </div>

    <!-- Tedarikçi Tablosu -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-light">
            <h4 class="mb-0">Tedarikçi Listesi</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table mb-0 fs-7">
                    <thead class="table-light">
                        <tr>

                            <th>Kýsa Ad</th>
                            <th>Tam Ad</th>
                            <th>Vergi Dairesi</th>
                            <th>Vergi No</th>
                            <th>Adres</th>
                            <th>Sabit Telefon</th>
                            <th>GSM Numarasý</th>
                            <th>Email</th>
                            <th>Durum</th>
                            <th>Ýþlemler</th>
                            <th>Bilgi</th>

                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="s in suppliers" :key="s.id">

                            <td>{{ s.shortName }}</td>
                            <td>{{ s.fullName }}</td>
                            <td>{{ s.taxOffice }}</td>
                            <td>{{ s.taxNumber }}</td>
                            <td>{{ s.address }}</td>
                            <td>{{ s.landlinePhone }}</td>
                            <td>{{ s.mobilePhone }}</td>
                            <td>{{ s.email }}</td>
                            <td>
                                <span :class="s.isActive ? 'badge bg-success' : 'badge bg-danger'">
                                    {{ s.isActive ? 'Aktif' : 'Pasif' }}
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-light me-1"
                                        v-on:click="editSupplier(s)">
                                    <i class="mdi mdi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-danger"
                                        v-on:click="deleteSupplier(s)">
                                    <i class="mdi mdi-delete"></i>
                                </button>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-dark d-flex align-items-center justify-content-center me-1"
                                         v-on:click="showSupplierInfo(s)">
                                      <svg width="16" height="19" fill="currentColor"
                                             viewBox="0 0 24 24"
                                             xmlns="http://www.w3.org/2000/svg"
                                             class="me-0">
                                        
                                        <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                        
                                    </svg>
                                    
                                </button>





                               
                            </td>
                        </tr>
                        <tr v-if="!suppliers.length">
                            <td colspan="7" class="text-center py-3">Hiç tedarikçi bulunamadý</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Tedarikçi Form Modal -->
    <div class="modal fade" id="supplierModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <form class="modal-content" v-on:submit.prevent="saveSupplier">
                <div class="modal-header">
                    <h5 class="modal-title">
                        {{ isEditing ? 'Tedarikçi Düzenle' : 'Yeni Tedarikçi Ekle' }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Kýsa Ad *</label>
                            <input type="text" class="form-control"
                                   v-model="currentSupplier.shortName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Tam Ad *</label>
                            <input type="text" class="form-control"
                                   v-model="currentSupplier.fullName" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">Vergi No *</label>
                            <input type="text" class="form-control"
                                   v-model="currentSupplier.taxNumber" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Vergi Dairesi *</label>
                            <input type="text" class="form-control"
                                   v-model="currentSupplier.taxOffice" required>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label">GSM Numarasý</label>
                            <input type="tel" class="form-control"
                                   v-model="currentSupplier.mobilePhone">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Sabit Telefon</label>
                            <input type="tel" class="form-control"
                                   v-model="currentSupplier.landlinePhone">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Email</label>
                        <input type="email" class="form-control"
                               v-model="currentSupplier.email">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Adres</label>
                        <textarea class="form-control" rows="3"
                                  v-model="currentSupplier.address"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Açýklama</label>
                        <textarea class="form-control" rows="2"
                                  v-model="currentSupplier.notes"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Durum</label>
                        <select class="form-select" v-model="currentSupplier.isActive">
                            <option :value="true">Aktif</option>
                            <option :value="false">Pasif</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Ýptal
                    </button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Bigli Modal  -->
    <div class="modal fade" id="supplierInfoModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content p-0 border-0 bg-transparent">
                <div class="modal-body p-0">
                    fskgkdfdfgdf
                    <!-- brutalist-card -->
                    <div class="brutalist-card">
                        <div class="brutalist-card__header">
                            <div class="brutalist-card__icon">
                                
                                <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10
                         10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z" />
                                </svg>
                            </div>
                            <!-- Duruma göre renk -->
                            <div class="brutalist-card__alert"
                                 :class="selectedSupplier.isActive ? 'text-success' : 'text-danger'">
                                {{ selectedSupplier.isActive ? 'Aktif' : 'Pasif' }}
                            </div>
                        </div>
                        <div class="brutalist-card__message">
                            <p><strong>Kýsa Ad:</strong> {{ selectedSupplier.shortName }}</p>
                            <p><strong>Tam Ad:</strong> {{ selectedSupplier.fullName }}</p>


                            <p><strong>Vergi Dairesi:</strong> {{ selectedSupplier.taxOffice }}</p>

                            <p><strong>Vergi No:</strong> {{ selectedSupplier.taxNumber }}</p>
                            <p><strong>Adres:</strong> {{ selectedSupplier.address }}</p>
                            <p><strong>Sabit Telefon:</strong> {{ selectedSupplier.landlinePhone }}</p>
                            <p><strong>GSM Numarasý:</strong> {{ selectedSupplier.mobilePhone }}</p>
                            <p><strong>Email:</strong> {{ selectedSupplier.email }}</p>



                            <!-- istediðin diðer alanlarý buraya ekle -->
                        </div>
                        <div class="brutalist-card__actions">
                            <button type="button"
                                    class="brutalist-card__button brutalist-card__button--read"
                                    data-bs-dismiss="modal">
                                Kapat
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Tedarikçi Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bu tedarikçiyi silmek istediðinize emin misiniz?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Ýptal
                    </button>
                    <button type="button" class="btn btn-danger"
                            v-on:click="confirmDelete">
                        Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/lib/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
          const app = Vue.createApp({
            data() {
              return {
                suppliers: [],
                    selectedSupplier: {},
                currentSupplier: {
                  id: 0,
                  shortName: '',
                  fullName: '',
                      taxOffice: '',
                  taxNumber: '',
                  address: '',
                  landlinePhone: '',
                      mobilePhone: '',
                  email: '',
                  notes: '',
                  isActive: true
                },
                supplierToDelete: null,
                isEditing: false,
                searchQuery: '',
                supplierModal: null,
                deleteModal: null
              };
            },
            mounted() {
              this.loadSuppliers();
              this.$nextTick(() => {
                this.supplierModal = new bootstrap.Modal(
                  document.getElementById('supplierModal')
                );
                this.deleteModal = new bootstrap.Modal(
                  document.getElementById('deleteConfirmModal')
                );
                    this.infoModal = new bootstrap.Modal(
                  document.getElementById('supplierInfoModal')
                );
              });
            },
            methods: {
                    showSupplierInfo(s) {
                this.selectedSupplier = s;
                this.infoModal.show();
              },
              async loadSuppliers() {
                const res = await axios.get('/api/SuppliersApi');
                this.suppliers = res.data;
              },
              showCreateForm() {
                this.isEditing = false;
                this.currentSupplier = {
                  id: 0,
                  shortName: '',
                  fullName: '',
                      taxOffice: '',
                  taxNumber: '',
                  address: '',
                  LandlinePhone: '',
                  MobilePhone: '',
                  email: '',
                  notes: '',
                  isActive: true
                };
                this.supplierModal.show();
              },
              editSupplier(s) {
                this.isEditing = true;
                this.currentSupplier = { ...s };
                this.supplierModal.show();
              },
              async saveSupplier() {
                if (this.isEditing) {
                  await axios.put(
                    `/api/SuppliersApi/${this.currentSupplier.id}`,
                    this.currentSupplier
                  );
                } else {
                  await axios.post(
                    '/api/SuppliersApi',
                    this.currentSupplier
                  );
                }
                this.supplierModal.hide();
                await this.loadSuppliers();
              },
              deleteSupplier(s) {
                this.supplierToDelete = s;
                this.deleteModal.show();
              },
              async confirmDelete() {
                await axios.delete(
                  `/api/SuppliersApi/${this.supplierToDelete.id}`
                );
                this.deleteModal.hide();
                await this.loadSuppliers();
              },
              searchSuppliers() {
                if (!this.searchQuery.trim()) {
                  this.loadSuppliers();
                  return;
                }
                const q = this.searchQuery.toLowerCase();
                this.suppliers = this.suppliers.filter(s =>
                  s.shortName.toLowerCase().includes(q) ||
                  s.fullName.toLowerCase().includes(q) ||
                  s.taxNumber.includes(q)
                );
              }
            }
          });
          app.mount('#supplierApp');
        });
    </script>
}
