@{
    ViewData["Title"] = "Malzeme/Ürün Bazlı Çıkış Verileri";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .fs-7 {
            font-size: .875rem !important;
        }

        .fs-8 {
            font-size: .75rem !important;
        }
    </style>
</head>
<body>
    <div id="reportMaterialExitApp" class="container py-4" v-cloak>
        <div class="d-flex justify-content-between mb-4">
            <h2>@ViewData["Title"]</h2>
        </div>

        <!-- Filtreler -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Filtreler</h5>
            </div>
            <div class="card-body">
                <div class="row g-2">
                    <!-- Birim select -->
                    <div class="col-md-2">
                        <label class="form-label">Birim</label>
                        <select class="form-select" v-model="filters.department">
                            <option value="">Tümü</option>
                            <option v-for="d in departments" :key="d.id" :value="d.name">
                                {{ d.name }}
                            </option>
                        </select>
                    </div>
                    <!-- Ekip select -->
                    <div class="col-md-2">
                        <label class="form-label">Ekip</label>
                        <select class="form-select"
                                v-model="filters.teamId"
                                :disabled="!filters.department">
                            <option value="">Tümü</option>
                            <option v-for="t in filteredTeams" :key="t.id" :value="t.id">
                                {{ t.teamName }}
                            </option>
                        </select>
                    </div>
                    <!-- Malzeme select -->
                    <div class="col-md-4">
                        <label class="form-label">Malzeme/Ürün</label>
                        <select class="form-select" v-model="filters.materialId">
                            <option value="">Tümü</option>
                            <option v-for="m in materials" :key="m.id" :value="m.id">
                                {{ m.code }} – {{ m.name }}
                            </option>
                        </select>
                    </div>
                    <!-- Tarihler -->
                    <div class="col-md-2">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" v-model="filters.startDate" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input type="date" class="form-control" v-model="filters.endDate" />
                    </div>
                </div>
                <div class="text-end mt-3">
                    <button class="btn btn-success me-2" @@click="exportToExcel">
                        <i class="mdi mdi-file-excel"></i> Excel'e Aktar
                    </button>
                    <button class="btn btn-outline-dark me-2" @@click="applyFilters">
                        <i class="mdi mdi-filter"></i> Filtrele
                    </button>
                    <button class="btn btn-dark" @@click="resetFilters">
                        <i class="mdi mdi-filter-remove"></i> Temizle
                    </button>
                </div>
            </div>
        </div>

        <!-- Tablo -->
        <div class="table-responsive">
            <table class="table table-striped table-hover fs-7">
                <thead class="table-light">
                    <tr>
                        <th>Kod</th>
                        <th>Adı</th>
                        <th>Birim</th>
                        <th>Tarih</th>
                        <th>Ekip</th>
                        <th>Miktar</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="e in pagedEntries" :key="e.id">
                        <td>{{ materialById(e.materialId).code }}</td>
                        <td>{{ materialById(e.materialId).name }}</td>
                        <td>{{ materialById(e.materialId).unit }}</td>
                        <td>{{ formatDate(e.date) }}</td>
                        <td>{{ teamById(e.customerTeamId).teamName }}</td>
                        <td class="text-end">{{ e.quantity }}</td>
                    </tr>
                    <tr v-if="filtered.length===0">
                        <td colspan="6" class="text-center py-3">Kayıt bulunamadı</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <label>
                    Sayfa başı:
                    <select v-model.number="perPage" @@change="changePerPage"
                            class="form-select form-select-sm d-inline-block" style="width:auto">
                        <option v-for="opt in perPageOptions" :key="opt" :value="opt">{{ opt }}</option>
                    </select>
                </label>
            </div>
            <div>
                <button v-for="p in pages" :key="p"
                        class="btn btn-outline-dark btn-sm mx-1"
                        :class="{ 'active': p === currentPage }"
                        @@click="changePage(p)">
                    {{ p }}
                </button>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/lib/vue.global.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
        <script>
            Vue.createApp({
                data() {
                    return {
                        materials: [],        // malzemeler
                        customerTeams: [],    // tüm ekipler
                        departments: [],      // birimler
                        materialExits: [],    // serverdan dönen çıkış verisi
                        filtered: [],         // filtrelendikten sonra gösterilen liste

                        filters: {
                            department: '',
                            teamId: '',
                            materialId: '',
                            startDate: '',
                            endDate: ''
                        },

                        currentPage: 1,
                        perPageOptions: [5,10,20,50],
                        perPage: 10
                    }
                },
                computed: {
                    filteredTeams() {
                        if (!this.filters.department) return this.customerTeams;
                        return this.customerTeams.filter(t => t.department === this.filters.department);
                    },
                    // sayfalama
                    totalPages() {
                        return Math.ceil(this.filtered.length / this.perPage) || 1
                    },
                    pages() {
                        return Array.from({ length: this.totalPages }, (_, i) => i + 1)
                    },
                    pagedEntries() {
                        const start = (this.currentPage - 1) * this.perPage;
                        return this.filtered.slice(start, start + this.perPage);
                    }
                },
                methods: {
                    // serverdan verileri çek
                    async loadData() {
                        const [ms, ts, ds, es] = await Promise.all([
                            axios.get('/api/MaterialsApi'),
                            axios.get('/api/CustomerTeamsApi'),
                            axios.get('/api/DepartmentsApi'),
                            axios.get('/api/MaterialExitsApi')
                        ]);
                        this.materials      = ms.data;
                        this.customerTeams  = ts.data;
                        this.departments    = ds.data;
                        this.materialExits  = es.data;
                        this.filtered       = [...this.materialExits];
                    },
                    materialById(id) {
                        return this.materials.find(m => m.id === id) || {};
                    },
                    teamById(id) {
                        return this.customerTeams.find(t => t.id === id) || {};
                    },
                    formatDate(d) {
                        return new Date(d).toLocaleDateString('tr-TR');
                    },
                    applyFilters() {
                        let r = [...this.materialExits];
                        if (this.filters.department)
                            r = r.filter(e =>
                                this.teamById(e.customerTeamId).department === this.filters.department
                            );
                        if (this.filters.teamId)
                            r = r.filter(e => e.customerTeamId == this.filters.teamId);
                        if (this.filters.materialId)
                            r = r.filter(e => e.materialId == this.filters.materialId);
                        if (this.filters.startDate)
                            r = r.filter(e => new Date(e.date) >= new Date(this.filters.startDate));
                        if (this.filters.endDate)
                            r = r.filter(e => new Date(e.date) <= new Date(this.filters.endDate));
                        this.filtered = r;
                        this.currentPage = 1;
                    },
                    resetFilters() {
                        this.filters = {
                            department: '',
                            teamId: '',
                            materialId: '',
                            startDate: '',
                            endDate: ''
                        };
                        this.filtered = [...this.materialExits];
                        this.currentPage = 1;
                    },
                    exportToExcel() {
                        const wsData = [
                            ["Kod","Adı","Birim","Tarih","Ekip","Miktar"]
                        ];
                        this.filtered.forEach(e => {
                            const mat = this.materialById(e.materialId);
                            const team = this.teamById(e.customerTeamId);
                            wsData.push([
                                mat.code, mat.name, mat.unit,
                                this.formatDate(e.date),
                                team.teamName, e.quantity
                            ]);
                        });
                        const ws = XLSX.utils.aoa_to_sheet(wsData);
                        const wb = XLSX.utils.book_new();
                        XLSX.utils.book_append_sheet(wb, ws, "Çıkış Verileri");
                        XLSX.writeFile(wb, "cikis_verileri.xlsx");
                    },
                    changePage(p) { if (p>=1 && p<=this.totalPages) this.currentPage = p },
                    changePerPage() { this.currentPage = 1 }
                },
                async mounted() {
                    await this.loadData();
                }
            }).mount('#reportMaterialExitApp');
        </script>
    }
</body>
</html>
