@{
    ViewData["Title"] = "Kategori Hiyerarşisi";
}
<style>

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */
</style>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        .tree-view {
            list-style: none;
            padding-left: 1rem;
        }

        .tree-view-item {
            margin: .25rem 0;
        }

        .tree-view-toggle {
            cursor: pointer;
            width: 1rem;
            display: inline-block;
        }

        .tree-view-label {
            cursor: pointer;
        }
    </style>
</head>
<body>
    <div id="kategoriHiyerarsiApp" class="container py-4" v-cloak>
        <div class="d-flex justify-content-between mb-4">
            <h2>Kategori Hiyerarşisi (Ağaç Yapısı)</h2>
            <div>
                <button class="btn btn-outline-dark " v-on:click="openAll">
                    Tümünü Aç
                </button>&nbsp;&nbsp;
                <button class="btn btn-dark" v-on:click="closeAll">
                    Tümünü Kapat
                </button>

            </div>
        </div>

        <div class="card mb-4">
            <div class="card-body p-3">
                <ul class="tree-view">
                    <li v-for="mc in mainCategories" :key="mc.id" class="tree-view-item">
                        <span class="tree-view-toggle" v-on:click="toggle(mc.id)">
                            <i :class="expanded[mc.id] ? 'mdi mdi-chevron-down' : 'mdi mdi-chevron-right'"></i>
                        </span>
                        <span class="tree-view-label" v-on:click="toggle(mc.id)">
                            <strong>{{ mc.code }}. {{ mc.name }}</strong>
                        </span>
                        <ul class="tree-view" v-show="expanded[mc.id]">
                            <li v-for="sc in subCategories.filter(s=>s.mainCategoryId===mc.id)" :key="sc.id" class="tree-view-item">
                                <span class="tree-view-toggle" v-on:click="toggle(sc.id)">
                                    <i :class="expanded[sc.id] ? 'mdi mdi-chevron-down' : 'mdi mdi-chevron-right'"></i>
                                </span>
                                <span class="tree-view-label" v-on:click="toggle(sc.id)">
                                    {{ sc.code }}. {{ sc.name }}
                                </span>
                                <ul class="tree-view" v-show="expanded[sc.id]">
                                    <li v-for="mt in materialTypes.filter(t=>t.subCategoryId===sc.id)" :key="mt.id" class="tree-view-item">
                                        <span class="tree-view-toggle" v-on:click="toggle(mt.id)">
                                            <i :class="expanded[mt.id] ? 'mdi mdi-chevron-down' : 'mdi mdi-chevron-right'"></i>
                                        </span>
                                        <span class="tree-view-label" v-on:click="toggle(mt.id)">
                                            {{ mt.code }}. {{ mt.name }}
                                        </span>
                                        <ul class="tree-view" v-show="expanded[mt.id]">
                                            <li v-for="m in materials.filter(x=>x.materialTypeId===mt.id)" :key="m.id" class="tree-view-item">
                                                <span class="ms-3">{{ m.code }}. {{ m.name }}</span>
                                            </li>
                                        </ul>
                                    </li>
                                </ul>
                            </li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/lib/vue.global.js"></script>
        <script>
            const app = Vue.createApp({
              data() {
                return {
                  mainCategories: [],
                  subCategories: [],
                  materialTypes: [],
                  materials: [],
                  expanded: {}
                };
              },
              async mounted() {
                await this.loadData();


              },
              methods: {



                        async loadData() {
              try {
                const [mc, sc, mt, m] = await Promise.all([
                  axios.get('/api/MainCategoriesApi'),
                  axios.get('/api/SubCategoriesApi'),
                  axios.get('/api/ProductTypesApi'),
                  axios.get('/api/MaterialsApi')
                ]);

                this.mainCategories = mc?.data || [];
                this.subCategories  = sc?.data || [];
                this.materialTypes  = mt?.data || [];
                this.materials      = m?.data || [];

                const allIds = [
                  ...this.mainCategories.map(c => c.id),
                  ...this.subCategories.map(s => s.id),
                  ...this.materialTypes.map(t => t.id)
                ];

                allIds.forEach(id => {
                  this.expanded[id] = false;
                });

              } catch (err) {
                console.error("Veriler yüklenirken hata:", err);
                alert("Veriler alınamadı. Yetki sorunları veya sunucu hatası olabilir.");
              }
            },

                toggle(id) {
                  this.expanded[id] = !this.expanded[id];
                },

                openAll() {
                  Object.keys(this.expanded).forEach(id => {
                    this.expanded[id] = true;
                  });
                },

                closeAll() {
                  Object.keys(this.expanded).forEach(id => {
                    this.expanded[id] = false;
                  });
                },

                printReport() {
                  window.print();
                }
              }
            });
            app.mount('#kategoriHiyerarsiApp');
        </script>
    }
</body>
</html>
