@{
    ViewData["Title"] = "Malzeme/Ürün Bazlı Giriş Verileri";
}
<style>

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */
</style>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div id="reportMaterialEntryApp" class="container py-4" v-cloak>
        <div class="d-flex justify-content-between mb-4">
            <h2>@ViewData["Title"]</h2>

        </div>

        <!-- Filtreler -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Filtreler</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Malzeme/Ürün</label>
                        <select class="form-select" v-model="filters.materialId">
                            <option value="">Tümü</option>
                            <option v-for="m in materials" :key="m.id" :value="m.id">
                                {{ m.code }} - {{ m.name }}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" v-model="filters.startDate" />
                    </div>
                    <div class="col-md-2 mb-3">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input type="date" class="form-control" v-model="filters.endDate" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Tedarikçi</label>
                        <select class="form-select" v-model="filters.supplierId">
                            <option value="">Tümü</option>
                            <option v-for="s in suppliers" :key="s.id" :value="s.id">
                                {{ s.shortName }}
                            </option>
                        </select>
                    </div>
                </div>
                <div class="text-end">
                    <button class="btn btn-success" v-on:click="exportToExcel">
                        <i class="mdi mdi-file-excel"></i> Excel'e Aktar
                    </button>&nbsp;
                    <button class="btn btn-outline-dark" v-on:click="applyFilters">
                        <i class="mdi mdi-filter"></i> Filtrele
                    </button>&nbsp;
                    <button class="btn btn-dark" v-on:click="resetFilters">
                        <i class="mdi mdi-filter-remove"></i> Filtreleri Temizle
                    </button>
                </div>
            </div>
        </div>

        <!-- Tablo -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Kod</th>
                        <th>Adı</th>
                        <th>Birim</th>
                        <th>Tarih</th>
                        <th>Tedarikçi</th>
                        <th>Birim Fiyat</th>
                        <th>Miktar</th>
                        <th>Toplam Fiyat</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="e in pagedEntries" :key="e.id">
                        <td>{{ materialById(e.materialId).code }}</td>
                        <td>{{ materialById(e.materialId).name }}</td>
                        <td>{{ materialById(e.materialId).unit }}</td>
                        <td>{{ formatDate(e.date) }}</td>
                        <td>{{ supplierById(e.supplierId).shortName }}</td>
                        <td>{{ formatPrice(e.unitPrice) }}</td>
                        <td>{{ e.quantity }}</td>
                        <td>{{ formatPrice(e.quantity * e.unitPrice) }}</td>
                    </tr>
                    <tr v-if="filtered.length===0">
                        <td colspan="8" class="text-center">Bu kriterlere uygun malzeme girişi bulunamadı.</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <!-- pagination controls -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <label>
                    Sayfa Başı:
                    <select v-model.number="perPage" @@change="changePerPage"
                            class="form-select form-select-sm d-inline-block"
                            style="width:auto">
                        <option v-for="opt in perPageOptions" :key="opt" :value="opt">
                            {{ opt }}
                        </option>
                    </select>
                </label>
            </div>
            <div>
                <button v-for="p in pages" :key="p"
                        class="btn btn-outline-dark btn-sm mx-1"
                        :class="{ 'active': p === currentPage }"
                        @@click="changePage(p)">
                    {{ p }}
                </button>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="~/lib/vue.global.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>

        <script>
            Vue.createApp({
                data() {
                    return {
                        materials: [],
                        suppliers: [],
                        materialEntries: [],
                        filtered: [],
                        filters: { materialId:'', startDate:'', endDate:'', supplierId: '' },
                        currentPage: 1,
                        perPageOptions: [5, 10, 20, 50],
                        perPage: 10,
                    };
                },
                async mounted() {
                    await this.loadData();
                },
                            computed: {
              totalPages() {
                return Math.ceil(this.filtered.length / this.perPage) || 1;
              },
              pages() {
                return Array.from({ length: this.totalPages }, (_, i) => i + 1);
              },
              pagedEntries() {
                const start = (this.currentPage - 1) * this.perPage;
                return this.filtered.slice(start, start + this.perPage);
              }
            },
                methods: {
                exportToExcel() {
                    const wsData = [
                        ["Kod", "Adı", "Birim", "Tarih", "Tedarikçi", "Birim Fiyat", "Miktar", "Toplam"]
                    ];
                    this.filtered.forEach(e => {
                        const material = this.materialById(e.materialId);
                        const supplier = this.supplierById(e.supplierId);
                        wsData.push([
                            material.code,
                            material.name,
                            material.unit,
                            this.formatDate(e.date),
                            supplier.shortName,
                            e.unitPrice,
                            e.quantity,
                            (e.unitPrice * e.quantity)
                        ]);
                    });

                    const ws = XLSX.utils.aoa_to_sheet(wsData);
                    const wb = XLSX.utils.book_new();
                    XLSX.utils.book_append_sheet(wb, ws, "Giriş Verileri");
                    XLSX.writeFile(wb, "giris_verileri.xlsx");
                },
                                changePage(p) {
              if (p >= 1 && p <= this.totalPages) {
                this.currentPage = p;
              }
            },
            changePerPage() {
              this.currentPage = 1;
            },
                    async loadData() {
                        const [mRes, sRes, eRes] = await Promise.all([
                            axios.get('/api/MaterialsApi'),
                            axios.get('/api/SuppliersApi'),
                            axios.get('/api/MaterialEntriesApi')
                        ]);
                        this.materials      = mRes.data;
                        this.suppliers      = sRes.data;
                        this.materialEntries= eRes.data;
                        this.filtered       = [...this.materialEntries];
                        this.currentPage = 1;
                    },
                    materialById(id) {
                        return this.materials.find(x => x.id === id) || {};
                    },
                    supplierById(id) {
                        return this.suppliers.find(x => x.id === id) || {};
                    },
                    formatDate(d) {
                        return new Date(d).toLocaleDateString('tr-TR');
                    },
                    formatPrice(x) {
                        return x.toLocaleString('tr-TR',{minimumFractionDigits:2})+' ₺';
                    },
                    applyFilters() {
                        let r = [...this.materialEntries];
                        if(this.filters.materialId)
                            r = r.filter(e => e.materialId == this.filters.materialId);
                        if(this.filters.startDate)
                            r = r.filter(e => new Date(e.date) >= new Date(this.filters.startDate));
                        if(this.filters.endDate)
                            r = r.filter(e => new Date(e.date) <= new Date(this.filters.endDate));
                        if (this.filters.supplierId)
                             r = r.filter(e => e.supplierId == this.filters.supplierId);

                        this.filtered = r;
                        this.currentPage = 1;
                    },
                    resetFilters() {
                                    this.filters = {
                materialId: '',
                supplierId: '',
                startDate: '',
                endDate: ''
            };
                        this.filtered = [...this.materialEntries];
                    },
                    printReport() {
                        window.print();
                    }
                }
            }).mount('#reportMaterialEntryApp');
        </script>
    }
</body>
</html>
