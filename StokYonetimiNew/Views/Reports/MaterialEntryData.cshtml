@{
    ViewData["Title"] = "Malzeme/Ürün Bazlı Giriş Verileri";
}
<style>

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */
</style>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div id="reportMaterialEntryApp" class="container py-4" v-cloak>
        <div class="d-flex justify-content-between mb-4">
            <h2>@ViewData["Title"]</h2>
            
        </div>

        <!-- Filtreler -->
        <div class="card mb-4">
            <div class="card-header bg-light">
                <h5 class="mb-0">Filtreler</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Malzeme/Ürün</label>
                        <select class="form-select" v-model="filters.materialId">
                            <option value="">Tümü</option>
                            <option v-for="m in materials" :key="m.id" :value="m.id">
                                {{ m.code }} - {{ m.name }}
                            </option>
                        </select>
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Başlangıç Tarihi</label>
                        <input type="date" class="form-control" v-model="filters.startDate" />
                    </div>
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Bitiş Tarihi</label>
                        <input type="date" class="form-control" v-model="filters.endDate" />
                    </div>
                </div>
                <div class="text-end">
                    <button class="btn btn-outline-dark" v-on:click="applyFilters">
                        <i class="mdi mdi-filter"></i> Filtrele
                    </button>&nbsp;
                    <button class="btn btn-dark" v-on:click="resetFilters">
                        <i class="mdi mdi-filter-remove"></i> Filtreleri Temizle
                    </button>
                </div>
            </div>
        </div>

        <!-- Tablo -->
        <div class="table-responsive">
            <table class="table table-striped table-hover">
                <thead>
                    <tr>
                        <th>Kod</th>
                        <th>Adı</th>
                        <th>Birim</th>
                        <th>Tarih</th>
                        <th>Tedarikçi</th>
                        <th>Birim Fiyat</th>
                        <th>Miktar</th>
                        <th>Toplam Fiyat</th>
                    </tr>
                </thead>
                <tbody>
                    <tr v-for="e in filtered" :key="e.id">
                        <td>{{ materialById(e.materialId).code }}</td>
                        <td>{{ materialById(e.materialId).name }}</td>
                        <td>{{ materialById(e.materialId).unit }}</td>
                        <td>{{ formatDate(e.date) }}</td>
                        <td>{{ supplierById(e.supplierId).shortName }}</td>
                        <td>{{ formatPrice(e.unitPrice) }}</td>
                        <td>{{ e.quantity }}</td>
                        <td>{{ formatPrice(e.quantity * e.unitPrice) }}</td>
                    </tr>
                    <tr v-if="filtered.length===0">
                        <td colspan="8" class="text-center">Bu kriterlere uygun malzeme girişi bulunamadı.</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    @section Scripts {
        <script src="~/lib/vue.global.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script>
            Vue.createApp({
                data() {
                    return {
                        materials: [],
                        suppliers: [],
                        materialEntries: [],
                        filtered: [],
                        filters: { materialId:'', startDate:'', endDate:'' }
                    };
                },
                async mounted() {
                    await this.loadData();
                },
                methods: {
                    async loadData() {
                        const [mRes, sRes, eRes] = await Promise.all([
                            axios.get('/api/MaterialsApi'),
                            axios.get('/api/SuppliersApi'),
                            axios.get('/api/MaterialEntriesApi')
                        ]);
                        this.materials      = mRes.data;
                        this.suppliers      = sRes.data;
                        this.materialEntries= eRes.data;
                        this.filtered       = [...this.materialEntries];
                    },
                    materialById(id) {
                        return this.materials.find(x => x.id === id) || {};
                    },
                    supplierById(id) {
                        return this.suppliers.find(x => x.id === id) || {};
                    },
                    formatDate(d) {
                        return new Date(d).toLocaleDateString('tr-TR');
                    },
                    formatPrice(x) {
                        return x.toLocaleString('tr-TR',{minimumFractionDigits:2})+' ₺';
                    },
                    applyFilters() {
                        let r = [...this.materialEntries];
                        if(this.filters.materialId)
                            r = r.filter(e => e.materialId == this.filters.materialId);
                        if(this.filters.startDate)
                            r = r.filter(e => new Date(e.date) >= new Date(this.filters.startDate));
                        if(this.filters.endDate)
                            r = r.filter(e => new Date(e.date) <= new Date(this.filters.endDate));
                        this.filtered = r;
                    },
                    resetFilters() {
                        this.filters = { materialId:'', startDate:'', endDate:'' };
                        this.filtered = [...this.materialEntries];
                    },
                    printReport() {
                        window.print();
                    }
                }
            }).mount('#reportMaterialEntryApp');
        </script>
    }
</body>
</html>
