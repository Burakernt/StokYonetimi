@{
    ViewData["Title"] = "Malzeme Grup Tanımları";
}
<style>

     .fs-7 {
         font-size: 0.875rem !important;
     }
     /* 14px */
     .fs-8 {
         font-size: 0.75rem !important;
     }
     /* 12px */
</style>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />

<div id="materialGroupApp" class="container py-4" v-cloak>
    <h2>@ViewData["Title"]</h2>

    <div class="mb-4 d-flex">
        <button type="button" class="btn btn-outline-dark me-2" v-on:click="showCreateMainCategoryForm">
            Yeni Ana Kategori
        </button>
        <button type="button" class="btn btn-dark me-2" v-on:click="showCreateSubCategoryForm">
            Yeni Alt Kategori
        </button>
        <button type="button" class="btn btn-primary" v-on:click="showCreateProductTypeForm">
            Yeni Malzeme/Ürün Türü
        </button>
    </div>

    <div class="row">
        <!-- Ana Kategoriler -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">Ana Kategoriler</div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item"
                        v-for="cat in mainCategories"
                        :key="cat.id"
                        :class="{active: selectedMainCategory?.id===cat.id}"
                        v-on:click="selectMainCategory(cat)">
                        <span class="badge bg-secondary me-2">{{cat.code}}</span>{{cat.name}}
                        <span class="float-end">
                            <button type="button" class="btn btn-sm btn-light me-1" v-on:click.stop="editMainCategory(cat)">✎</button>
                            <button type="button" class="btn btn-sm btn-danger" v-on:click.stop="deleteMainCategory(cat)">🗑</button>
                        </span>
                    </li>
                    <li v-if="mainCategories.length===0" class="list-group-item text-center">
                        Hiç ana kategori yok
                    </li>
                </ul>
            </div>
        </div>

        <!-- Alt Kategoriler -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">Alt Kategoriler</div>
                <div class="card-body" v-if="!selectedMainCategory">Bir ana kategori seçin</div>
                <ul class="list-group list-group-flush" v-else>
                    <li class="list-group-item"
                        v-for="sub in filteredSubCategories"
                        :key="sub.id"
                        :class="{active: selectedSubCategory?.id===sub.id}"
                        v-on:click="selectSubCategory(sub)">
                        <span class="badge bg-info me-2">{{sub.code}}</span>{{sub.name}}
                        <span class="float-end">
                            <button type="button" class="btn btn-sm btn-light me-1" v-on:click.stop="editSubCategory(sub)">✎</button>
                            <button type="button" class="btn btn-sm btn-danger" v-on:click.stop="deleteSubCategory(sub)">🗑</button>
                        </span>
                    </li>
                    <li v-if="filteredSubCategories.length===0" class="list-group-item text-center">
                        Bu kategoride alt kategori yok
                    </li>
                </ul>
            </div>
        </div>

        <!-- Malzeme/Ürün Türleri -->
        <div class="col-md-4">
            <div class="card mb-4">
                <div class="card-header">Malzeme/Ürün Türleri</div>
                <div class="card-body" v-if="!selectedSubCategory">Bir alt kategori seçin</div>
                <ul class="list-group list-group-flush" v-else>
                    <li class="list-group-item"
                        v-for="pt in filteredProductTypes"
                        :key="pt.id"
                        :class="{active: selectedProductType?.id===pt.id}"
                        v-on:click="selectProductType(pt)">
                        <span class="badge bg-warning me-2">{{pt.code}}</span>{{pt.name}}
                        <span class="float-end">
                            <button type="button" class="btn btn-sm btn-light me-1" v-on:click.stop="editProductType(pt)">✎</button>
                            <button type="button" class="btn btn-sm btn-danger" v-on:click.stop="deleteProductType(pt)">🗑</button>
                        </span>
                    </li>
                    <li v-if="filteredProductTypes.length===0" class="list-group-item text-center">
                        Bu alt kategoride malzeme/ürün türü yok
                    </li>
                </ul>
            </div>
        </div>
    </div>

    <!-- Modaller -->
    <!-- Ana Kategori Modal -->
    <div class="modal fade" id="mainCategoryModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" v-on:submit.prevent="saveMainCategory">
                <div class="modal-header">
                    <h5 class="modal-title">{{ isEditingMainCategory ? 'Düzenle' : 'Yeni Ana Kategori' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kod *</label>
                        <input v-model="currentMainCategory.code" class="form-control" readonly maxlength="2" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ad *</label>
                        <input v-model="currentMainCategory.name" class="form-control" required maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Alt Kategori Modal -->
    <div class="modal fade" id="subCategoryModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" v-on:submit.prevent="saveSubCategory">
                <div class="modal-header">
                    <h5 class="modal-title">{{ isEditingSubCategory ? 'Düzenle' : 'Yeni Alt Kategori' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kod *</label>
                        <input v-model="currentSubCategory.code" class="form-control" readonly maxlength="4" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ad *</label>
                        <input v-model="currentSubCategory.name" class="form-control" required maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Malzeme/Ürün Türü Modal -->
    <div class="modal fade" id="productTypeModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" v-on:submit.prevent="saveProductType">
                <div class="modal-header">
                    <h5 class="modal-title">{{ isEditingProductType ? 'Düzenle' : 'Yeni Tür' }}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Kod *</label>
                        <input v-model="currentProductType.code" class="form-control" readonly maxlength="7" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Ad *</label>
                        <input v-model="currentProductType.name" class="form-control" required maxlength="100" />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Silme Onayı Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        {{
                        deleteTarget==='main' ? 'Ana Kategori Sil'
                        : deleteTarget==='sub'  ? 'Alt Kategori Sil'
                        :                          'Tür Sil'
                        }}
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p v-if="deleteTarget==='main'">
                        Bu ana kategoriyi ve tüm alt kategorilerini silmek istediğinize emin misiniz?
                    </p>
                    <p v-else-if="deleteTarget==='sub'">
                        Bu alt kategoriyi ve türlerini silmek istediğinize emin misiniz?
                    </p>
                    <p v-else>
                        Bu türü silmek istediğinize emin misiniz?
                    </p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button class="btn btn-danger" v-on:click="confirmDelete">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const app = Vue.createApp({
          data() {
            return {
              mainCategories: [],
              subCategories: [],
              productTypes: [],

              currentMainCategory:  { id:0, code:'',   name:'' },
              currentSubCategory:   { id:0, mainCategoryId:0, code:'',   name:'' },
              currentProductType:   { id:0, subCategoryId:0,   code:'',   name:'' },

              selectedMainCategory:  null,
              selectedSubCategory:   null,
              selectedProductType:   null,

              isEditingMainCategory: false,
              isEditingSubCategory:  false,
              isEditingProductType:  false,

              deleteTarget: 'main',
              itemToDelete:  null,

              modal: { main:null, sub:null, product:null, delete:null }
            }
          },
          computed: {
            filteredSubCategories() {
              return this.subCategories.filter(sc => sc.mainCategoryId === this.selectedMainCategory?.id);
            },
            filteredProductTypes() {
              return this.productTypes.filter(pt => pt.subCategoryId === this.selectedSubCategory?.id);
            }
          },
          mounted() {
            this.modal.main    = new bootstrap.Modal(document.getElementById('mainCategoryModal'));
            this.modal.sub     = new bootstrap.Modal(document.getElementById('subCategoryModal'));
            this.modal.product = new bootstrap.Modal(document.getElementById('productTypeModal'));
            this.modal.delete  = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
            this.loadAll();
          },
          methods: {
            // — Load
            async loadAll() {
              this.mainCategories = (await axios.get('/api/MainCategoriesApi')).data;
              this.subCategories  = (await axios.get('/api/SubCategoriesApi')).data;
              this.productTypes   = (await axios.get('/api/ProductTypesApi')).data;
            },

            // — Seçimler
            selectMainCategory(c) {
              this.selectedMainCategory = c; this.selectedSubCategory = null; this.selectedProductType = null;
            },
            selectSubCategory(sc) {
              this.selectedSubCategory = sc; this.selectedProductType = null;
            },
            selectProductType(pt) {
              this.selectedProductType = pt;
            },

            // — Kod üreticileri
            generateNextMainCode() {
              const nums = this.mainCategories.map(c => +c.code);
              const next = nums.length ? Math.max(...nums)+1 : 1;
              return String(next).padStart(2,'0');
            },
            generateNextSubCode() {
              const p = this.selectedMainCategory.code;
              const nums = this.subCategories
                .filter(sc => sc.mainCategoryId===this.selectedMainCategory.id)
                .map(sc => +sc.code.slice(p.length));
              const next = nums.length ? Math.max(...nums)+1 : 1;
              return p + String(next).padStart(2,'0');
            },
            generateNextProductTypeCode() {
              const p = this.selectedSubCategory.code;
              const nums = this.productTypes
                .filter(pt => pt.subCategoryId===this.selectedSubCategory.id)
                .map(pt => +pt.code.slice(p.length));
              const next = nums.length ? Math.max(...nums)+1 : 1;
              return p + String(next).padStart(3,'0');
            },

            // — Ana Kategori CRUD
            showCreateMainCategoryForm() {
              this.isEditingMainCategory = false;
              this.currentMainCategory = { id:0, code:this.generateNextMainCode(), name:'' };
              this.modal.main.show();
            },
            editMainCategory(c) {
              this.isEditingMainCategory = true;
              this.currentMainCategory = { ...c };
              this.modal.main.show();
            },
            async saveMainCategory() {
              if (this.isEditingMainCategory) {
                await axios.put(`/api/MainCategoriesApi/${this.currentMainCategory.id}`, this.currentMainCategory);
              } else {
                await axios.post('/api/MainCategoriesApi', this.currentMainCategory);
              }
              this.modal.main.hide();
              await this.loadAll();
            },
            deleteMainCategory(c) {
              this.deleteTarget='main'; this.itemToDelete=c;
              this.modal.delete.show();
            },

            // — Alt Kategori CRUD
            showCreateSubCategoryForm() {
              if (!this.selectedMainCategory) return alert('Önce ana kategori seçin');
              this.isEditingSubCategory=false;
              this.currentSubCategory = {
                id:0,
                mainCategoryId:this.selectedMainCategory.id,
                code:this.generateNextSubCode(),
                name:''
              };
              this.modal.sub.show();
            },
            editSubCategory(sc) {
              this.isEditingSubCategory=true;
              this.currentSubCategory={...sc};
              this.modal.sub.show();
            },
            async saveSubCategory() {
              if (this.isEditingSubCategory) {
                await axios.put(`/api/SubCategoriesApi/${this.currentSubCategory.id}`, this.currentSubCategory);
              } else {
                await axios.post('/api/SubCategoriesApi', this.currentSubCategory);
              }
              this.modal.sub.hide();
              await this.loadAll();
            },
            deleteSubCategory(sc) {
              this.deleteTarget='sub'; this.itemToDelete=sc;
              this.modal.delete.show();
            },

            showCreateProductTypeForm() {
              if (!this.selectedSubCategory) return alert('Önce alt kategori seçin');
              this.isEditingProductType=false;
              this.currentProductType = {
                id:0,
                subCategoryId:this.selectedSubCategory.id,
                code:this.generateNextProductTypeCode(),
                name:''
              };
              this.modal.product.show();
            },
            editProductType(pt) {
              this.isEditingProductType=true;
              this.currentProductType={...pt};
              this.modal.product.show();
            },
            async saveProductType() {
              if (this.isEditingProductType) {
                await axios.put(`/api/ProductTypesApi/${this.currentProductType.id}`, this.currentProductType);
              } else {
                await axios.post('/api/ProductTypesApi', this.currentProductType);
              }
              this.modal.product.hide();
              await this.loadAll();
            },
            deleteProductType(pt) {
              this.deleteTarget='product'; this.itemToDelete=pt;
              this.modal.delete.show();
            },

            // — Silme onayı
            async confirmDelete() {
              if (this.deleteTarget==='main') {
                await axios.delete(`/api/MainCategoriesApi/${this.itemToDelete.id}`);
              } else if (this.deleteTarget==='sub') {
                await axios.delete(`/api/SubCategoriesApi/${this.itemToDelete.id}`);
              } else {
                await axios.delete(`/api/ProductTypesApi/${this.itemToDelete.id}`);
              }
              this.modal.delete.hide();
              await this.loadAll();
            }
          }
        });
        app.mount('#materialGroupApp');
    </script>
}
