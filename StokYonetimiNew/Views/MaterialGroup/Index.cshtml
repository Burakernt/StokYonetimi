@{
    ViewData["Title"] = "Malzeme Grup Tanımları";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">







    <div id="materialGroupApp" style="margin-top:50px">
        <div class="d-flex justify-content-between mb-4" style="margin-bottom:0px">
            <h2>Malzeme Grup Tanımları</h2>
        

    </div>
    <hr style="border: none; border-top: 1px solid black; margin-top: 10px; margin-bottom:30px">

    <div class="d-flex justify-content-end" style="margin-top: 10px; margin-bottom:30px">
        <button class="btn btn-outline-dark me-2" v-on:click="showCreateMainCategoryForm" style="margin-right:70px; padding:25px; padding-top:12px;padding-bottom:12px; font-weight:600">
            <i class="mdi mdi-plus"></i> Yeni Ana Kategori
        </button>
        <button class="btn btn-dark" v-on:click="showCreateSubCategoryForm" style="margin-right:70px; padding:25px; padding-top:12px;padding-bottom:12px; font-weight:600">
            <i class="mdi mdi-plus"></i> Yeni Alt Kategori
        </button>
    </div>


    <div class="row">
        <!-- Ana Kategoriler ve Alt Kategoriler -->
        <div class="col-md-5">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="card-title mb-0">Ana Kategoriler</h5>
                </div>
                <div class="card-body">
                    <div class="list-group">
                        <a href="#" class="list-group-item list-group-item-action"
                           v-for="category in mainCategories" 
                           :key="category.id"
                           :class="{'active': selectedMainCategory && selectedMainCategory.id === category.id}"
                           v-on:click="selectMainCategory(category)">
                            <div class="d-flex justify-content-between align-items-center">
                                <div>
                                    <span class="badge bg-secondary me-2">{{category.code}}</span>
                                    {{category.name}}
                                </div>
                                <div>
                                    <button class="btn btn-sm btn-light border border-dark rounded-2 me-1"
                                            v-on:click.stop="editMainCategory(category)">
                                        <i class="mdi mdi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger border border-dark rounded-2"
                                            v-on:click.stop="deleteMainCategory(category)">
                                        <i class="mdi mdi-delete"></i>
                                    </button>
                                </div>

                            </div>
                        </a>
                        <div v-if="mainCategories.length === 0" class="text-center py-3">
                            Hiç ana kategori bulunamadı.
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-7">
            <div class="card">
                <div class="card-header">
                    <h5 class="card-title mb-0">Alt Kategoriler</h5>
                </div>
                <div class="card-body">
                    <div v-if="!selectedMainCategory" class="text-center py-3">
                        Alt kategorileri görmek için bir ana kategori seçin.
                    </div>
                    <div v-else>
                        <h6 class="mb-3">
                            <span class="badge bg-secondary me-2">{{selectedMainCategory.code}}</span>
                            {{selectedMainCategory.name}} - Alt Kategorileri
                        </h6>
                        <div class="list-group">
                            <a href="#" class="list-group-item list-group-item-action"
                               v-for="subcategory in filteredSubCategories" 
                               :key="subcategory.id"
                               :class="{'active': selectedSubCategory && selectedSubCategory.id === subcategory.id}"
                               v-on:click="selectSubCategory(subcategory)">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-info me-2">{{subcategory.code}}</span>
                                        {{subcategory.name}}
                                    </div>
                                    <div>
                                        <button class="btn btn-sm btn-light border border-dark rounded-2 me-1"
                                                v-on:click.stop="editSubCategory(subcategory)">
                                            <i class="mdi mdi-pencil"></i>
                                        </button>
                                        <button class="btn btn-sm btn-danger border border-dark rounded-2"
                                                v-on:click.stop="deleteSubCategory(subcategory)">
                                            <i class="mdi mdi-delete"></i>
                                        </button>
                                    </div>
                                </div>
                            </a>
                            <div v-if="filteredSubCategories.length === 0" class="text-center py-3">
                                Bu ana kategoride hiç alt kategori bulunmamaktadır.
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Ana Kategori Modal -->
    <div class="modal fade" id="mainCategoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{isEditingMainCategory ? 'Ana Kategori Düzenle' : 'Yeni Ana Kategori Ekle'}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form @@submit.prevent="saveMainCategory">
                        <!--   <div class="mb-3">
                            <label class="form-label">Kategori Kodu *</label>
                            <input type="text" class="form-control" v-model="currentMainCategory.code" required maxlength="2" :readonly="isEditingMainCategory">
                            <small class="text-muted" v-if="!isEditingMainCategory">İki haneli kod girin (01-99)</small>
                        </div> -->
                        <div class="mb-3">
                            <label class="form-label">Kategori Adı *</label>
                            <input type="text" class="form-control" v-model="currentMainCategory.name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>
                            <textarea class="form-control" v-model="currentMainCategory.description" rows="2"></textarea>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Alt Kategori Modal -->
    <div class="modal fade" id="subCategoryModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{isEditingSubCategory ? 'Alt Kategori Düzenle' : 'Yeni Alt Kategori Ekle'}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form @@submit.prevent="saveSubCategory">
                        <div class="mb-3">
                            <label class="form-label">Ana Kategori *</label>
                            <select class="form-select" v-model="currentSubCategory.mainCategoryId" required :disabled="isEditingSubCategory">
                                <option v-for="category in mainCategories" :key="category.id" :value="category.id">
                                    {{category.code}} - {{category.name}}
                                </option>
                            </select>
                        </div>
                        <!-- <div class="mb-3">
                            <label class="form-label">Alt Kategori Kodu *</label>
                            <input type="text" class="form-control" v-model="currentSubCategory.code" required maxlength="5" :readonly="isEditingSubCategory">
                            <small class="text-muted" v-if="!isEditingSubCategory">Format: Ana kategori kodu + İki haneli kod (örn: 01.01)</small>
                        </div>-->
                        <div class="mb-3">
                            <label class="form-label">Alt Kategori Adı *</label>
                            <input type="text" class="form-control" v-model="currentSubCategory.name" required>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>
                            <textarea class="form-control" v-model="currentSubCategory.description" rows="2"></textarea>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{deleteTarget === 'main' ? 'Ana Kategori Sil' : 'Alt Kategori Sil'}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p v-if="deleteTarget === 'main'">
                        Bu ana kategoriyi silmek istediğinize emin misiniz? Bu işlem alt kategorileri de silecektir.
                    </p>
                    <p v-else>
                        Bu alt kategoriyi silmek istediğinize emin misiniz?
                    </p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-danger" v-on:click="confirmDelete">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/vue.global.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const app = Vue.createApp({
                data() {
                    return {
                        mainCategories: [],
                        subCategories: [],
                        currentMainCategory: {
                            id: 0,
                            code: '',
                            name: '',
                            description: ''
                        },
                        currentSubCategory: {
                            id: 0,
                            mainCategoryId: 0,
                            code: '',
                            name: '',
                            description: ''
                        },
                        selectedMainCategory: null,
                        selectedSubCategory: null,
                        isEditingMainCategory: false,
                        isEditingSubCategory: false,
                        deleteTarget: 'main',
                        itemToDelete: null,
                        mainCategoryModal: null,
                        subCategoryModal: null,
                        deleteModal: null
                    }
                },
                computed: {
                    filteredSubCategories() {
                        if (!this.selectedMainCategory) return [];
                        return this.subCategories.filter(sc => sc.mainCategoryId === this.selectedMainCategory.id);
                    }
                },
                mounted: function() {
                    this.loadData();
                    this.mainCategoryModal = new bootstrap.Modal(document.getElementById('mainCategoryModal'));
                    this.subCategoryModal = new bootstrap.Modal(document.getElementById('subCategoryModal'));
                    this.deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                },
                methods: {
                    loadData: function() {
                        // Ana kategorileri yükle
                        // axios.get('/api/main-categories').then(response => {
                        //     this.mainCategories = response.data;
                        // });
                        
                        // Alt kategorileri yükle
                        // axios.get('/api/sub-categories').then(response => {
                        //     this.subCategories = response.data;
                        // });
                        
                        // Şimdilik test verisi kullanıyoruz
                        this.mainCategories = [
                            { id: 1, code: '01', name: 'Elektronik', description: 'Elektronik ürünler' },
                            { id: 2, code: '02', name: 'Mekanik', description: 'Mekanik parçalar' },
                            { id: 3, code: '03', name: 'Ofis', description: 'Ofis malzemeleri' }
                        ];
                        
                        this.subCategories = [
                            { id: 1, mainCategoryId: 1, code: '01.01', name: 'Bilgisayarlar', description: 'PC, Laptop' },
                            { id: 2, mainCategoryId: 1, code: '01.02', name: 'Telefonlar', description: 'Mobil cihazlar' },
                            { id: 3, mainCategoryId: 2, code: '02.01', name: 'Motorlar', description: 'DC ve AC motorlar' },
                            { id: 4, mainCategoryId: 3, code: '03.01', name: 'Kağıt Ürünleri', description: 'Kağıt, defter, vs.' }
                        ];
                    },
                    
                    // Ana Kategori İşlemleri
                    selectMainCategory: function(category) {
                        this.selectedMainCategory = category;
                        this.selectedSubCategory = null;
                    },
                    showCreateMainCategoryForm: function() {
                        this.isEditingMainCategory = false;
                        this.currentMainCategory = {
                            id: 0,
                            code: '',
                            name: '',
                            description: ''
                        };
                        this.mainCategoryModal.show();
                    },
                    editMainCategory: function(category) {
                        this.isEditingMainCategory = true;
                        this.currentMainCategory = { ...category };
                        this.mainCategoryModal.show();
                    },
                    saveMainCategory: function() {
                        if (this.isEditingMainCategory) {
                            // PUT isteği - güncelleme
                            // axios.put('/api/main-categories/' + this.currentMainCategory.id, this.currentMainCategory)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.mainCategoryModal.hide();
                            //     });
                            
                            // Şimdilik manuel güncelleme
                            const index = this.mainCategories.findIndex(c => c.id === this.currentMainCategory.id);
                            if (index !== -1) {
                                this.mainCategories.splice(index, 1, {...this.currentMainCategory});
                                if (this.selectedMainCategory && this.selectedMainCategory.id === this.currentMainCategory.id) {
                                    this.selectedMainCategory = {...this.currentMainCategory};
                                }
                            }
                        } else {
                            // POST isteği - yeni ekleme
                            // axios.post('/api/main-categories', this.currentMainCategory)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.mainCategoryModal.hide();
                            //     });
                            
                            // Şimdilik manuel ekleme
                            const newId = Math.max(0, ...this.mainCategories.map(c => c.id)) + 1;
                            this.currentMainCategory.id = newId;
                            this.mainCategories.push({...this.currentMainCategory});
                        }
                        this.mainCategoryModal.hide();
                    },
                    deleteMainCategory: function(category) {
                        this.deleteTarget = 'main';
                        this.itemToDelete = category;
                        this.deleteModal.show();
                    },
                    
                    // Alt Kategori İşlemleri
                    selectSubCategory: function(subcategory) {
                        this.selectedSubCategory = subcategory;
                    },
                    showCreateSubCategoryForm: function() {
                        this.isEditingSubCategory = false;
                        this.currentSubCategory = {
                            id: 0,
                            mainCategoryId: this.selectedMainCategory ? this.selectedMainCategory.id : 0,
                            code: this.selectedMainCategory ? this.selectedMainCategory.code + '.01' : '',
                            name: '',
                            description: ''
                        };
                        this.subCategoryModal.show();
                    },
                    editSubCategory: function(subcategory) {
                        this.isEditingSubCategory = true;
                        this.currentSubCategory = { ...subcategory };
                        this.subCategoryModal.show();
                    },
                    saveSubCategory: function() {
                        if (this.isEditingSubCategory) {
                            // PUT isteği - güncelleme
                            // axios.put('/api/sub-categories/' + this.currentSubCategory.id, this.currentSubCategory)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.subCategoryModal.hide();
                            //     });
                            
                            // Şimdilik manuel güncelleme
                            const index = this.subCategories.findIndex(sc => sc.id === this.currentSubCategory.id);
                            if (index !== -1) {
                                this.subCategories.splice(index, 1, {...this.currentSubCategory});
                                if (this.selectedSubCategory && this.selectedSubCategory.id === this.currentSubCategory.id) {
                                    this.selectedSubCategory = {...this.currentSubCategory};
                                }
                            }
                        } else {
                            // POST isteği - yeni ekleme
                            // axios.post('/api/sub-categories', this.currentSubCategory)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.subCategoryModal.hide();
                            //     });
                            
                            // Şimdilik manuel ekleme
                            const newId = Math.max(0, ...this.subCategories.map(sc => sc.id)) + 1;
                            this.currentSubCategory.id = newId;
                            this.subCategories.push({...this.currentSubCategory});
                        }
                        this.subCategoryModal.hide();
                    },
                    deleteSubCategory: function(subcategory) {
                        this.deleteTarget = 'sub';
                        this.itemToDelete = subcategory;
                        this.deleteModal.show();
                    },
                    
                    // Silme İşlemleri
                    confirmDelete: function() {
                        if (this.deleteTarget === 'main' && this.itemToDelete) {
                            // Ana kategori silme
                            // axios.delete('/api/main-categories/' + this.itemToDelete.id)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.deleteModal.hide();
                            //     });
                            
                            // Şimdilik manuel silme
                            const index = this.mainCategories.findIndex(c => c.id === this.itemToDelete.id);
                            if (index !== -1) {
                                this.mainCategories.splice(index, 1);
                                
                                // Bağlı alt kategorileri de sil
                                this.subCategories = this.subCategories.filter(sc => sc.mainCategoryId !== this.itemToDelete.id);
                                
                                // Seçili kategori silinirse seçimi kaldır
                                if (this.selectedMainCategory && this.selectedMainCategory.id === this.itemToDelete.id) {
                                    this.selectedMainCategory = null;
                                    this.selectedSubCategory = null;
                                }
                            }
                        } else if (this.deleteTarget === 'sub' && this.itemToDelete) {
                            // Alt kategori silme
                            // axios.delete('/api/sub-categories/' + this.itemToDelete.id)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.deleteModal.hide();
                            //     });
                            
                            // Şimdilik manuel silme
                            const index = this.subCategories.findIndex(sc => sc.id === this.itemToDelete.id);
                            if (index !== -1) {
                                this.subCategories.splice(index, 1);
                                
                                // Seçili alt kategori silinirse seçimi kaldır
                                if (this.selectedSubCategory && this.selectedSubCategory.id === this.itemToDelete.id) {
                                    this.selectedSubCategory = null;
                                }
                            }
                        }
                        this.deleteModal.hide();
                        this.itemToDelete = null;
                    }
                }
            });
            app.mount('#materialGroupApp');
        });
    </script>
}
