@model IEnumerable<StokYonetimiNew.Models.MaterialEntry>
@{
    ViewData["Title"] = "Malzeme/Ürün Girişi";
}

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/lib/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/index.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/vue-next-select.iife.prod.js"></script>
    <style>
        .fs-7 {
            font-size: 0.875rem !important;
        }

        .fs-8 {
            font-size: 0.75rem !important;
        }

        .vns-panel .vns-option-text {
            font-size: 0.75rem !important;
        }
    </style>
</head>
<body>
    <div id="materialEntryApp" class="container py-4" v-cloak>
        <h2>@ViewData["Title"]</h2>
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="h5 mb-0">Yeni Giriş</span>
            <button class="btn btn-outline-dark me-2" v-on:click="saveMaterialEntries">
                <i class="mdi mdi-content-save"></i> Kaydet
            </button>
        </div>
        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">
                <div class="row g-2">
                    <div class="col-sm-4">
                        <label class="form-label form-label-sm">Tarih</label>
                        <input type="date" class="form-control form-control-sm" v-model="form.date" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label form-label-sm">Fatura No</label>
                        <input type="text" class="form-control form-control-sm" v-model="form.invoiceNumber" placeholder="Örn: A12345" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label form-label-sm">Tedarikçi</label>
                        <select class="form-select form-select-sm" v-model.number="form.supplierId">
                            <option :value="null">Seçiniz</option>
                            <option v-for="s in suppliers" :key="s.id" :value="s.id">{{ s.shortName }}</option>
                        </select>
                    </div>
                </div>
                <hr class="my-2" />
                <h6 class="mb-2">Detaylar</h6>
                <div v-for="(item, idx) in form.items" :key="idx" class="row g-2 align-items-end mb-3">
                    <div class="col-sm-5">
                        <label class="form-label">Malzeme/Ürün</label>
                        <vue-next-select v-model="item.materialId"
                                         :options="materials"
                                         valueKey="id"
                                         labelKey="name"
                                         placeholder="Malzeme seçin..."
                                         clearable
                                         class="fs-7"
                                         style="min-width:500px; z-index:2000">
                            <template #dropdown-item="{ option }">
                                {{ option.code }} - {{ option.name }}<span v-if="option.unit"> ({{ option.unit }})</span>
                            </template>
                            <template #tag="{ option }">
                                {{ option.code }} - {{ option.name }}<span v-if="option.unit"> ({{ option.unit }})</span>
                            </template>
                        </vue-next-select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label form-label-sm">Miktar</label>
                        <input type="number" class="form-control form-control-sm" v-model.number="item.quantity" min="1" />
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label form-label-sm">Birim Fiyat (KDV Hariç)</label>
                        <input type="number" class="form-control form-control-sm" v-model.number="item.unitPrice" step="0.01" min="0" />
                    </div>
                    <div class="col-sm-1">
                        <label class="form-label form-label-sm">KDV</label>
                        <input type="number" class="form-control form-control-sm" v-model.number="item.kdv" step="0.01" min="0" />
                    </div>
                    <div class="col-sm-1 text-end">
                        <button class="btn btn-danger btn-sm" v-on:click="removeItem(idx)"><i class="mdi mdi-minus"></i></button>
                    </div>
                </div>
                <div class="text-center">
                    <button class="btn btn-dark" v-on:lick="addItem"><i class="mdi mdi-plus"></i> Satır Ekle</button>
                </div>
            </div>
        </div>
        <div class="card shadow-sm">
            <div class="card-header bg-light"><h6 class="mb-0">Geçmiş Girişler</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 fs-7">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Fatura No</th>
                                <th>Tedarikçi</th>
                                <th>Malzeme</th>
                                <th class="text-end">Miktar</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">Toplam</th>
                                <th class="text-center">Sil</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="e in entries" :key="e.id">
                                <td>{{ formatDate(e.date) }}</td>
                                <td>{{ e.invoiceNumber }}</td>
                                <td>{{ e.supplier.shortName }}</td>
                                <td>{{ e.material.code }} – {{ e.material.name }}</td>
                                <td class="text-end">{{ e.quantity }}</td>
                                <td class="text-end">{{ formatPrice(e.unitPrice) }}</td>
                                <td class="text-end">{{ formatPrice(e.quantity * e.unitPrice) }}</td>
                                <td class="text-center"><button class="btn btn-sm btn-danger" v-on:click="deleteEntry(e.id)">🗑</button></td>
                            </tr>
                            <tr v-if="entries.length === 0"><td colspan="8" class="text-center py-3">Kayıt bulunamadı</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
    @section Scripts {
        <script>
            const app = Vue.createApp({
                data() {
                    return { suppliers: [], materials: [], entries: [], form: { date: new Date().toISOString().slice(0,10), invoiceNumber:'', supplierId:null, items:[{ materialId:null, quantity:1, unitPrice:0, kdv:0 }] } };
                },
                async mounted() {
                    const [supR, matR, entR] = await Promise.all([ axios.get('/api/SuppliersApi'), axios.get('/api/MaterialsApi'), axios.get('/api/MaterialEntriesApi') ]);
                    this.suppliers = supR.data; this.materials = matR.data; this.entries = entR.data;
                },
                methods: {
                    formatDate(d) { return new Date(d).toLocaleDateString('tr-TR'); },
                    formatPrice(x) { return x.toLocaleString('tr-TR',{minimumFractionDigits:2})+' ₺'; },
                    addItem() { this.form.items.push({ materialId:null, quantity:1, unitPrice:0, kdv:0 }); },
                    removeItem(i) { if(this.form.items.length>1) this.form.items.splice(i,1); },
                    async saveMaterialEntries() {
                        if(!this.form.date||!this.form.invoiceNumber||!this.form.supplierId) return alert('Tarih, fatura no ve tedarikçi gerekli');
                        for(const it of this.form.items) {
                            if(!it.materialId||it.quantity<1||it.unitPrice<0) return alert('Malzeme, miktar ve fiyat girilmeli');
                                      await axios.post('/api/MaterialEntriesApi', {
                          date:             this.form.date,
                          invoiceNumber:    this.form.invoiceNumber,
                          supplierId:       Number(this.form.supplierId),
                          materialId:       mid,
                          quantity:         Number(it.quantity),
                          unitPrice:        Number(it.unitPrice),
                          kdv:              Number(it.kdv)
                        });
                        }
                        this.form = { date:new Date().toISOString().slice(0,10), invoiceNumber:'', supplierId:null, items:[{ materialId:null, quantity:1, unitPrice:0, kdv:0 }] };
                        await this.mounted(); alert('Kaydedildi');
                    },
                    async deleteEntry(id) { if(!confirm('Silinsin mi?')) return; await axios.delete(`/api/MaterialEntriesApi/${id}`); await this.mounted(); }
                }
            });
            app.component('vue-next-select', window.VueNextSelect);
            app.mount('#materialEntryApp');
        </script>
    }
</body>
</html>
