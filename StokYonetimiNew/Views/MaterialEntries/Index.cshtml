@model IEnumerable<StokYonetimiNew.Models.MaterialEntry>
@{
    ViewData["Title"] = "Malzeme/Ürün Girişi";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/index.min.css" />

    <style>
        .vue-select {
            display: block;
            width: 100%;
            padding: .375rem .75rem;
            font-size: 1rem;
            line-height: 1.5;
            color: #212529;
            background-color: #fff;
            border: 1px solid #ced4da;
            border-radius: .375rem;
            min-height: calc(1.5em + .75rem + 2px);
            transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        }

            .vue-select:focus {
                border-color: #86b7fe;
                outline: 0;
                box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
            }

        .fs-7 {
            font-size: .875rem !important;
        }

        .fs-8 {
            font-size: .75rem !important;
        }

        .btn-outline-dark.active {
            background-color: #212529;
            color: #fff;
        }
    </style>
</head>
<body>
    <div id="materialEntryApp" class="container py-4" v-cloak>
        <h2>@ViewData["Title"]</h2>

        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="h5 mb-0">Yeni Giriş</span>
            <div>
                <button class="btn btn-outline-dark me-2" @@click="saveMaterialEntries">
                    <i class="mdi mdi-content-save"></i>
                    <span v-if="!isEditing">Kaydet</span>
                    <span v-else>Güncelle</span>
                </button>
                <button v-if="isEditing" class="btn btn-outline-secondary" @@click="cancelEdit">
                    Vazgeç
                </button>
            </div>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">
                <div class="row g-2">
                    <div class="col-sm-4">
                        <label class="form-label ">Tarih</label>
                        <input type="date" class="form-control form-control-sm" v-model="form.date" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label ">Fatura No</label>
                        <input type="text" class="form-control form-control-sm"
                               v-model="form.invoiceNumber"
                               placeholder="Örn: A12345" />
                    </div>
                    <div class="col-sm-4">
                        <label class="form-label ">Tedarikçi</label>
                        <select class="form-select form-select-sm"
                                v-model.number="form.supplierId">
                            <option :value="null">Seçiniz</option>
                            <option v-for="s in suppliers" :key="s.id" :value="s.id">
                                {{ s.shortName }}
                            </option>
                        </select>
                    </div>
                </div>

                <hr class="my-2" />

                <h6 class="mb-2">Detaylar</h6>
                <div v-for="(item, idx) in form.items"
                     :key="idx"
                     class="row g-2 align-items-end mb-3">
                    <div class="col-sm-5">
                        <label class="form-label">Malzeme/Ürün</label>
                        <vue-next-select class="vue-select"
                                         v-model="item.material"
                                         :options="materials"
                                         label-by="name"
                                         placeholder="Malzeme seçin..."
                                         searchable>
                            <template #dropdown-item="{ option }">
                                {{ option.code }} – {{ option.name }}
                                <span v-if="option.unit">({{ option.unit }})</span>
                            </template>
                            <template #tag="{ option }">
                                {{ option.code }} – {{ option.name }}
                            </template>
                        </vue-next-select>
                    </div>

                    <div class="col-sm-2">
                        <label class="form-label ">Miktar</label>
                        <input type="number"
                               class="form-control form-control-sm"
                               v-model.number="item.quantity"
                               min="1" />
                    </div>

                    <div class="col-sm-2">
                        <label class="form-label ">Birim Fiyat (KDV Hariç)</label>
                        <input type="number"
                               class="form-control form-control-sm"
                               v-model.number="item.unitPrice"
                               step="0.01"
                               min="0" />
                    </div>

                    <div class="col-sm-1">
                        <label class="form-label ">KDV %</label>
                        <input type="number"
                               class="form-control form-control-sm"
                               v-model.number="item.kdv"
                               step="0.01"
                               min="0" />
                    </div>

                    <div class="col-sm-1 text-end">
                        <button class="btn btn-danger btn-sm" @@click="removeItem(idx)">
                            <i class="mdi mdi-minus"></i>
                        </button>
                    </div>
                </div>

                <div class="text-center">
                    <button class="btn btn-dark" @@click="addItem">
                        <i class="mdi mdi-plus"></i> Satır Ekle
                    </button>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-light"><h6 class="mb-0">Geçmiş Girişler</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 fs-7">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Fatura No</th>
                                <th>Tedarikçi</th>
                                <th>Malzeme</th>
                                <th class="text-end">Miktar</th>
                                <th class="text-end">Birim Fiyat</th>
                                <th class="text-end">Toplam</th>
                                <th class="text-center fs-8" style="width:70px">KDV %</th>
                                <th class="text-center fs-8" style="width:80px">Düzenle</th>
                                <th class="text-center">Sil</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="e in pagedEntries" :key="e.id">
                                <td>{{ formatDate(e.date) }}</td>
                                <td>{{ e.invoiceNumber }}</td>
                                <td>{{ e.supplier.shortName }}</td>
                                <td>{{ e.material.code }} – {{ e.material.name }}</td>
                                <td class="text-end">{{ e.quantity }}</td>
                                <td class="text-end">{{ formatPrice(e.unitPrice) }}</td>
                                <td class="text-end">{{ formatPrice(e.quantity * e.unitPrice * (1 + e.kdv / 100)) }}</td>
                                <td class="text-center">{{ e.kdv }} %</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light me-1" @@click="editEntry(e)">
                                        <i class="mdi mdi-pencil"></i>
                                    </button>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-danger" @@click="deleteEntry(e.id)">
                                        <i class="mdi mdi-delete"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr v-if="entries.length === 0">
                                <td colspan="10" class="text-center py-3">Kayıt bulunamadı</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <!-- Per-page selector -->
            <div>
                <label>
                    Sayfa Başı:
                    <select v-model.number="perPage"
                            @@change="changePerPage"
                            class="form-select form-select-sm d-inline-block"
                            style="width:auto">
                        <option v-for="opt in perPageOptions" :key="opt" :value="opt">
                            {{ opt }}
                        </option>
                    </select>
                </label>
            </div>
            <!-- Page buttons -->
            <div>
                <button v-for="p in pages" :key="p"
                        class="btn btn-outline-dark btn-sm mx-1"
                        :class="{ 'active': p===currentPage }"
                        @@click="changePage(p)">
                    {{ p }}
                </button>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="~/lib/vue.global.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/vue-next-select.iife.prod.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            const app = Vue.createApp({
              data() {
                return {
                    searchQuery: '',
                  suppliers: [], materials: [], entries: [],
                  currentPage: 1,
                  perPageOptions: [5,10,20,50],
                  perPage: 10,
                  isEditing: false,
                  editingId: null,
                  form: {
                    date: new Date().toISOString().slice(0,10),
                    invoiceNumber: '',
                    supplierId: null,
                    items: [{ material:null, quantity:1, unitPrice:0, kdv:20 }]
                  }
                };
              },
              computed: {
                            filteredMaterials() {
              return this.materials.filter(m =>
                m.name.toLowerCase().includes(this.searchQuery.toLowerCase()) ||
                m.code.toLowerCase().includes(this.searchQuery.toLowerCase())
              )
            },
                sortedEntries() {
                  return [...this.entries].sort((a,b)=>new Date(b.date)-new Date(a.date));
                },
                totalPages() {
                  return Math.ceil(this.sortedEntries.length/this.perPage) || 1;
                },
                pages() {
                  return Array.from({length:this.totalPages},(_,i)=>i+1);
                },
                pagedEntries() {
                  const start=(this.currentPage-1)*this.perPage;
                  return this.sortedEntries.slice(start, start+this.perPage);
                }
              },
              methods: {
                            onSearchChange(val) {
              this.searchQuery = val
            },
                async fetchLookups() {
                  const [supR,matR]=await Promise.all([
                    axios.get('/api/SuppliersApi'),
                    axios.get('/api/MaterialsApi')
                  ]);
                  this.suppliers=supR.data;
                  this.materials=matR.data;
                },
                async fetchEntries() {
                  const entR=await axios.get('/api/MaterialEntriesApi');
                  this.entries=entR.data;
                  if(this.currentPage>this.totalPages)this.currentPage=this.totalPages;
                },
                materialFilter(s,o){ return (!s) || ((o.name?.toLowerCase()??'')+' '+(o.code?.toLowerCase()??'')).includes(s.toLowerCase()); },
                formatDate(d){return new Date(d).toLocaleDateString('tr-TR');},
                formatPrice(x){return x.toLocaleString('tr-TR',{minimumFractionDigits:2})+' ₺';},
                addItem(){this.form.items.push({material:null,quantity:1,unitPrice:0,kdv:20});},
                removeItem(i){if(this.form.items.length>1)this.form.items.splice(i,1);},
                async saveMaterialEntries(){
                  if(!this.form.date||!this.form.invoiceNumber||!this.form.supplierId){
                    await Swal.fire({icon:'warning',title:'Eksik Bilgi',text:'Tarih, fatura no ve tedarikçi gerekli.'});return;}
                  for(const it of this.form.items){
                    if(!it.material||it.quantity<1||it.unitPrice<0){
                      await Swal.fire({icon:'warning',title:'Eksik Bilgi',text:'Malzeme, miktar ve fiyat girilmeli.'});return;}
                    const common={date:this.form.date,invoiceNumber:this.form.invoiceNumber,
                      supplierId:Number(this.form.supplierId),materialId:it.material.id,
                      quantity:Number(it.quantity),unitPrice:Number(it.unitPrice),kdv:Number(it.kdv)};
                    if(this.isEditing){
                      await axios.put(`/api/MaterialEntriesApi/${this.editingId}`,{id:this.editingId,...common});
                    } else {
                      await axios.post('/api/MaterialEntriesApi',common);
                    }
                  }
                  this.cancelEdit();await this.fetchEntries();
                  await Swal.fire({icon:'success',title:this.isEditing?'Güncelleme Tamamlandı':'Kaydetme Tamamlandı',timer:1500,showConfirmButton:false});
                },
                editEntry(e){
                  this.isEditing=true;this.editingId=e.id;
                  this.form.date=e.date.slice(0,10);
                  this.form.invoiceNumber=e.invoiceNumber;
                  this.form.supplierId=e.supplier.id;
                  this.form.items=[{material:e.material,quantity:e.quantity,unitPrice:e.unitPrice,kdv:e.kdv}];
                  window.scrollTo({top:0,behavior:'smooth'});
                },
                cancelEdit(){
                  this.isEditing=false;this.editingId=null;
                  this.form={date:new Date().toISOString().slice(0,10),invoiceNumber:'',supplierId:null,items:[{material:null,quantity:1,unitPrice:0,kdv:20}]};
                },
                async deleteEntry(id){
                  const res=await Swal.fire({title:'Emin misiniz?',text:'Bu kaydı silmek istediğinize emin misiniz?',icon:'warning',showCancelButton:true,confirmButtonText:'Evet, sil',cancelButtonText:'Hayır'});
                  if(!res.isConfirmed)return;
                  await axios.delete(`/api/MaterialEntriesApi/${id}`);
                  await this.fetchEntries();
                  await Swal.fire({icon:'success',title:'Silindi',timer:1200,showConfirmButton:false});
                },
                changePage(p){if(p>=1&&p<=this.totalPages)this.currentPage=p;},
                changePerPage(){this.currentPage=1;}
              },
              async mounted(){await this.fetchLookups();await this.fetchEntries();}
            });
            app.component('vue-next-select',VueNextSelect);
            app.mount('#materialEntryApp');
        </script>
    }

</body>
</html>
