@{
    ViewData["Title"] = "Müşteri/Ekip Tanımları";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">
<style scoped>
    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
        padding: 1rem;
    }

    .table-responsive {
        border-top: 1px solid #e9ecef;
    }

    .table th,
    .table td {
        vertical-align: middle;
    }

    .btn-outline-info,
    .btn-outline-danger {
        transition: transform 0.3s ease;
    }

        .btn-outline-info:hover,
        .btn-outline-danger:hover {
            transform: scale(1.05);
        }
</style>





    <div id="customerTeamApp" style="margin-top:50px">
        <div class="d-flex justify-content-between mb-4" style="margin-bottom:0px">
            <h2>Müşteri/Ekip Tanımları</h2>
        
        </div><hr style="border: none; border-top: 1px solid black; margin-top: 10px;">

    <div class="d-flex justify-content-end">
    <button class="btn btn-dark " v-on:click="showCreateForm" style="margin-right:70px; padding:25px; padding-top:12px;padding-bottom:12px; font-weight:600">
        <i class="mdi mdi-plus"></i> Yeni Müşteri/Ekip
    </button>
    </div>
    <!-- Müşteri/Ekipler Tablosu -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h4 class="mb-0">Müşteri/Ekip Listesi</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kod</th>
                            <th>Müşteri/Ekip Adı</th>
                            <th>Departman</th>
                            <th>İletişim Kişisi</th>
                            <th>Telefon</th>
                            <th>E-posta</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="team in customerTeams" :key="team.id">
                            <td><span class="badge bg-secondary">{{ team.code }}</span></td>
                            <td>{{ team.name }}</td>
                            <td>{{ getDepartmentName(team.departmentId) }}</td>
                            <td>{{ team.contactPerson }}</td>
                            <td>{{ team.phone }}</td>
                            <td>{{ team.email }}</td>
                            <td>
                                <span :class="team.isActive ? 'badge bg-success' : 'badge bg-danger'">
                                    {{ team.isActive ? 'Aktif' : 'Pasif' }}
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-light border border-dark rounded-2 me-1"
                                @@click ="editTeam(team)">
                                    <i class="mdi mdi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-danger border border-dark rounded-2"
                                @@click ="deleteTeam(team)">
                                    <i class="mdi mdi-delete"></i>
                                </button>
                            </td>

                        </tr>
                        <tr v-if="customerTeams.length === 0">
                            <td colspan="8" class="text-center py-3">Hiç müşteri/ekip bulunamadı</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Müşteri/Ekip Form Modal -->
    <div class="modal fade" id="customerTeamModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{isEditing ? 'Müşteri/Ekip Düzenle' : 'Yeni Müşteri/Ekip Ekle'}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form @@submit.prevent="saveTeam">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Müşteri/Ekip Kodu *</label>
                                <input type="text" class="form-control" v-model="currentTeam.code" required maxlength="10" :readonly="isEditing">
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Müşteri/Ekip Adı *</label>
                                <input type="text" class="form-control" v-model="currentTeam.name" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Departman *</label>
                                <select class="form-select" v-model="currentTeam.departmentId" required>
                                    <option value="">Seçiniz</option>
                                    <option v-for="department in departments" :key="department.id" :value="department.id">
                                        {{department.name}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">İletişim Kişisi</label>
                                <input type="text" class="form-control" v-model="currentTeam.contactPerson">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Telefon</label>
                                <input type="tel" class="form-control" v-model="currentTeam.phone">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">E-posta</label>
                                <input type="email" class="form-control" v-model="currentTeam.email">
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Adres</label>
                                <textarea class="form-control" v-model="currentTeam.address" rows="3"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Açıklama</label>
                                <textarea class="form-control" v-model="currentTeam.notes" rows="3"></textarea>
                                <div class="mt-3">
                                    <label class="form-label">Durum</label>
                                    <select class="form-select" v-model="currentTeam.isActive">
                                        <option :value="true">Aktif</option>
                                        <option :value="false">Pasif</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Müşteri/Ekip Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p>Bu müşteri/ekibi silmek istediğinize emin misiniz?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-danger" v-on:click="confirmDelete">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/vue.global.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const app = Vue.createApp({
                data() {
                    return {
                        customerTeams: [],
                        departments: [],
                        currentTeam: {
                            id: 0,
                            code: '',
                            name: '',
                            departmentId: '',
                            contactPerson: '',
                            phone: '',
                            email: '',
                            address: '',
                            notes: '',
                            isActive: true
                        },
                        teamToDelete: null,
                        isEditing: false,
                        customerTeamModal: null,
                        deleteModal: null
                    }
                },
                mounted() {
                    this.loadData();
                    this.customerTeamModal = new bootstrap.Modal(document.getElementById('customerTeamModal'));
                    this.deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                },
                methods: {
                    loadData: function() {
                        // Müşteri/Ekipleri yükle
                        // axios.get('/api/customer-teams').then(response => {
                        //     this.customerTeams = response.data;
                        // });
                        
                        // Departmanları yükle
                        // axios.get('/api/departments').then(response => {
                        //     this.departments = response.data;
                        // });
                        
                        // Şimdilik test verisi kullanıyoruz
                        this.departments = [
                            { id: 1, name: 'Satış' },
                            { id: 2, name: 'Üretim' },
                            { id: 3, name: 'Ar-Ge' },
                            { id: 4, name: 'Satın Alma' },
                            { id: 5, name: 'Muhasebe' }
                        ];
                        
                        this.customerTeams = [
                            {
                                id: 1,
                                code: 'MUS001',
                                name: 'ABC Müşteri',
                                departmentId: 1,
                                contactPerson: 'Ahmet Yılmaz',
                                phone: '0212 555 4433',
                                email: 'ahmet@abc.com',
                                address: 'İstanbul',
                                notes: 'Önemli müşteri',
                                isActive: true
                            },
                            {
                                id: 2,
                                code: 'EKP001',
                                name: 'Ar-Ge Ekibi',
                                departmentId: 3,
                                contactPerson: 'Mehmet Demir',
                                phone: '0212 555 6677',
                                email: 'mehmet@firma.com',
                                address: 'İstanbul',
                                notes: 'Ana Ar-Ge ekibi',
                                isActive: true
                            },
                            {
                                id: 3,
                                code: 'MUS002',
                                name: 'XYZ Müşteri',
                                departmentId: 1,
                                contactPerson: 'Ayşe Kaya',
                                phone: '0212 555 8899',
                                email: 'ayse@xyz.com',
                                address: 'Ankara',
                                notes: 'Düzenli sipariş',
                                isActive: true
                            }
                        ];
                    },
                    getDepartmentName: function(departmentId) {
                        if (!departmentId) return '-';
                        const department = this.departments.find(d => d.id === departmentId);
                        return department ? department.name : 'Bilinmiyor';
                    },
                    showCreateForm: function() {
                        this.isEditing = false;
                        this.currentTeam = {
                            id: 0,
                            code: this.generateNextCode(),
                            name: '',
                            departmentId: '',
                            contactPerson: '',
                            phone: '',
                            email: '',
                            address: '',
                            notes: '',
                            isActive: true
                        };
                        this.customerTeamModal.show();
                    },
                    generateNextCode: function() {
                        // Basit bir kod üretme
                        const existingCustomerCodes = this.customerTeams
                            .filter(t => t.code.startsWith('MUS'))
                            .map(t => parseInt(t.code.substring(3)));
                        
                        const nextCustomerNumber = existingCustomerCodes.length > 0 
                            ? Math.max(...existingCustomerCodes) + 1 
                            : 1;
                            
                        return 'MUS' + nextCustomerNumber.toString().padStart(3, '0');
                    },
                    editTeam: function(team) {
                        this.isEditing = true;
                        this.currentTeam = { ...team };
                        this.customerTeamModal.show();
                    },
                    saveTeam: function() {
                        if (this.isEditing) {
                            // PUT isteği - güncelleme
                            // axios.put('/api/customer-teams/' + this.currentTeam.id, this.currentTeam)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.customerTeamModal.hide();
                            //     });
                            
                            // Şimdilik manuel güncelleme
                            const index = this.customerTeams.findIndex(t => t.id === this.currentTeam.id);
                            if (index !== -1) {
                                this.customerTeams.splice(index, 1, {...this.currentTeam});
                            }
                        } else {
                            // POST isteği - yeni ekleme
                            // axios.post('/api/customer-teams', this.currentTeam)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.customerTeamModal.hide();
                            //     });
                            
                            // Şimdilik manuel ekleme
                            const newId = Math.max(0, ...this.customerTeams.map(t => t.id)) + 1;
                            this.currentTeam.id = newId;
                            this.customerTeams.push({...this.currentTeam});
                        }
                        this.customerTeamModal.hide();
                    },
                    deleteTeam: function(team) {
                        this.teamToDelete = team;
                        this.deleteModal.show();
                    },
                    confirmDelete: function() {
                        if (this.teamToDelete) {
                            // DELETE isteği
                            // axios.delete('/api/customer-teams/' + this.teamToDelete.id)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.deleteModal.hide();
                            //     });
                            
                            // Şimdilik manuel silme
                            const index = this.customerTeams.findIndex(t => t.id === this.teamToDelete.id);
                            if (index !== -1) {
                                this.customerTeams.splice(index, 1);
                            }
                            this.deleteModal.hide();
                        }
                    }
                }
            });
            app.mount('#customerTeamApp');
        });
    </script>
}
