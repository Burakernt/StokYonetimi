@{
    ViewData["Title"] = "Malzeme/Ürün Tanımları";
}
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">

<style scoped>
    .card {
        border: none;
        border-radius: 8px;
    }

    .card-header {
        border-bottom: 1px solid #e9ecef;
        padding: 1rem;
    }

    .table-responsive {
        border-top: 1px solid #e9ecef;
    }

    .table th,
    .table td {
        vertical-align: middle;
    }

    .btn-outline-info,
    .btn-outline-danger {
        transition: transform 0.3s ease;
    }

        .btn-outline-info:hover,
        .btn-outline-danger:hover {
            transform: scale(1.05);
        }
</style>





<div id="materialApp" style="margin-top:50px">
    <div class="d-flex justify-content-between mb-4" style="margin-bottom:0px">
        <h2>Malzeme/Ürün Tanımları</h2>
        
    </div>  <hr style="border: none; border-top: 1px solid black; margin-top: 10px;">


    <!-- Arama ve Filtreleme -->
    <div class="row mb-4 align-items-center" style="margin-top:50px">
        <div class="col-md-4">
            <div class="input-group">
                <span class="input-group-text bg-white border-dark">
                    <i class="mdi mdi-magnify"></i>
                </span>
                <input type="text" class="form-control form-control-sm border-dark"
                       v-model="searchQuery" placeholder="Malzeme ara..."
                       @@keyup.enter="searchMaterials" style="  padding-top:12px;padding-bottom:12px; font-weight:600">
                <button class="btn btn-outline-dark btn-sm" type="button"
                @@click ="searchMaterials">
                    Ara
                </button>
            </div>
        </div>
        <div class="col-md-4">
            <select class="form-select form-select-sm border-dark" v-model="categoryFilter" @@change="filterByCategory" style="margin-right:70px; padding:25px; padding-top:12px;padding-bottom:12px; font-weight:600">
                <option value="0">Tüm Kategoriler</option>
                <optgroup label="Ana Kategoriler">
                    <option v-for="category in mainCategories"
                            :key="'main-'+category.id"
                            :value="'main-'+category.id">
                        {{ category.code }} - {{ category.name }}
                    </option>
                </optgroup>
                <optgroup label="Alt Kategoriler">
                    <option v-for="subcategory in subCategories"
                            :key="'sub-'+subcategory.id"
                            :value="'sub-'+subcategory.id">
                        {{ subcategory.code }} - {{ subcategory.name }}
                    </option>
                </optgroup>
            </select>
        </div>
        <div class="col-md-4 text-end">
            <button class="btn btn-dark " @@click="showCreateForm" style="margin-right:70px; padding:25px; padding-top:12px;padding-bottom:12px; font-weight:600">
                <i class="mdi mdi-plus"></i> Yeni Malzeme
            </button>
        </div>
    </div>


    <!-- Malzeme Tablosu -->
    <div class="card shadow-sm">
        <div class="card-header bg-light">
            <h4 class="mb-0">Malzeme Listesi</h4>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Kod</th>
                            <th>Malzeme Adı</th>
                            <th>Kategori</th>
                            <th>Birim</th>
                            <th>Stok</th>
                            <th>Tedarikçi</th>
                            <th>Durum</th>
                            <th>İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr v-for="material in materials" :key="material.id">
                            <td><span class="badge bg-secondary">{{ material.code }}</span></td>
                            <td>{{ material.name }}</td>
                            <td>{{ getCategoryName(material) }}</td>
                            <td>{{ material.unit }}</td>
                            <td>{{ material.stockQuantity }}</td>
                            <td>{{ getSupplierName(material.supplierId) }}</td>
                            <td>
                                <span :class="material.isActive ? 'badge bg-success' : 'badge bg-danger'">
                                    {{ material.isActive ? 'Aktif' : 'Pasif' }}
                                </span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-light border border-dark rounded-2 me-1"
                                @@click ="editMaterial(material)">
                                    <i class="mdi mdi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-danger border border-dark rounded-2"
                                @@click ="deleteMaterial(material)">
                                    <i class="mdi mdi-delete"></i>
                                </button>
                            </td>

                        </tr>
                        <tr v-if="materials.length === 0">
                            <td colspan="8" class="text-center py-3">Hiç malzeme bulunamadı</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Malzeme Form Modal -->
    <div class="modal fade" id="materialModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">{{isEditing ? 'Malzeme Düzenle' : 'Yeni Malzeme Ekle'}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <form @@submit.prevent="saveMaterial">
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Ana Kategori *</label>
                                <select class="form-select" v-model="selectedMainCategoryId" @@change="loadSubCategories" required>
                                    <option value="">Seçiniz</option>
                                    <option v-for="category in mainCategories" :key="category.id" :value="category.id">
                                        {{category.code}} - {{category.name}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Alt Kategori *</label>
                                <select class="form-select" v-model="selectedSubCategoryId" @@change="loadMaterialTypes" required :disabled="!selectedMainCategoryId">
                                    <option value="">Seçiniz</option>
                                    <option v-for="subcategory in filteredSubCategories" :key="subcategory.id" :value="subcategory.id">
                                        {{subcategory.code}} - {{subcategory.name}}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Malzeme Tipi *</label>
                                <select class="form-select" v-model="currentMaterial.materialTypeId" required :disabled="!selectedSubCategoryId">
                                    <option value="">Seçiniz</option>
                                    <option v-for="type in filteredMaterialTypes" :key="type.id" :value="type.id">
                                        {{type.code}} - {{type.name}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Malzeme Kodu *</label>
                                <input type="text" class="form-control" v-model="currentMaterial.code" required :readonly="isEditing">
                            </div>
                            <div class="col-md-8">
                                <label class="form-label">Malzeme Adı *</label>
                                <input type="text" class="form-control" v-model="currentMaterial.name" required>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Birim *</label>
                                <select class="form-select" v-model="currentMaterial.unit" required>
                                    <option value="Adet">Adet</option>
                                    <option value="Kg">Kilogram</option>
                                    <option value="Lt">Litre</option>
                                    <option value="Mt">Metre</option>
                                    <option value="m²">Metrekare</option>
                                    <option value="m³">Metreküp</option>
                                    <option value="Paket">Paket</option>
                                    <option value="Kutu">Kutu</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Stok Miktarı</label>
                                <input type="number" class="form-control" v-model="currentMaterial.stockQuantity" min="0">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Tedarikçi</label>
                                <select class="form-select" v-model="currentMaterial.supplierId">
                                    <option value="">Seçiniz</option>
                                    <option v-for="supplier in suppliers" :key="supplier.id" :value="supplier.id">
                                        {{supplier.shortName}}
                                    </option>
                                </select>
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label class="form-label">Fiyat</label>
                                <div class="input-group">
                                    <input type="number" class="form-control" v-model="currentMaterial.price" min="0" step="0.01">
                                    <span class="input-group-text">TL</span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Min. Stok Seviyesi</label>
                                <input type="number" class="form-control" v-model="currentMaterial.minStockLevel" min="0">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label">Durum</label>
                                <select class="form-select" v-model="currentMaterial.isActive">
                                    <option :value="true">Aktif</option>
                                    <option :value="false">Pasif</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Açıklama</label>
                            <textarea class="form-control" v-model="currentMaterial.description" rows="3"></textarea>
                        </div>
                        <div class="text-end">
                            <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">İptal</button>
                            <button type="submit" class="btn btn-primary">Kaydet</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Malzeme Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat"></button>
                </div>
                <div class="modal-body">
                    <p>Bu malzemeyi silmek istediğinize emin misiniz?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="button" class="btn btn-danger" v-on:click="confirmDelete">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/lib/vue.global.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const app = Vue.createApp({
                data() {
                    return {
                        materials: [],
                        mainCategories: [],
                        subCategories: [],
                        materialTypes: [],
                        suppliers: [],
                        currentMaterial: {
                            id: 0,
                            code: '',
                            name: '',
                            materialTypeId: '',
                            unit: 'Adet',
                            stockQuantity: 0,
                            price: 0,
                            minStockLevel: 0,
                            supplierId: '',
                            description: '',
                            isActive: true
                        },
                        selectedMainCategoryId: '',
                        selectedSubCategoryId: '',
                        materialToDelete: null,
                        isEditing: false,
                        searchQuery: '',
                        categoryFilter: '0',
                        materialModal: null,
                        deleteModal: null
                    }
                },
                computed: {
                    filteredSubCategories() {
                        if (!this.selectedMainCategoryId) return [];
                        return this.subCategories.filter(sc => sc.mainCategoryId == this.selectedMainCategoryId);
                    },
                    filteredMaterialTypes() {
                        if (!this.selectedSubCategoryId) return [];
                        return this.materialTypes.filter(mt => mt.subCategoryId == this.selectedSubCategoryId);
                    }
                },
                mounted() {
                    this.loadData();
                    this.materialModal = new bootstrap.Modal(document.getElementById('materialModal'));
                    this.deleteModal = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                },
                methods: {
                    loadData: function() {
                        // Malzemeleri yükle
                        // axios.get('/api/materials').then(response => {
                        //     this.materials = response.data;
                        // });
                        
                        // Ana kategorileri yükle
                        // axios.get('/api/main-categories').then(response => {
                        //     this.mainCategories = response.data;
                        // });
                        
                        // Alt kategorileri yükle
                        // axios.get('/api/sub-categories').then(response => {
                        //     this.subCategories = response.data;
                        // });
                        
                        // Malzeme tiplerini yükle
                        // axios.get('/api/material-types').then(response => {
                        //     this.materialTypes = response.data;
                        // });
                        
                        // Tedarikçileri yükle
                        // axios.get('/api/suppliers').then(response => {
                        //     this.suppliers = response.data;
                        // });
                        
                        // Şimdilik test verisi kullanıyoruz
                        this.mainCategories = [
                            { id: 1, code: '01', name: 'Elektronik' },
                            { id: 2, code: '02', name: 'Mekanik' },
                            { id: 3, code: '03', name: 'Ofis' }
                        ];
                        
                        this.subCategories = [
                            { id: 1, mainCategoryId: 1, code: '01.01', name: 'Bilgisayarlar' },
                            { id: 2, mainCategoryId: 1, code: '01.02', name: 'Telefonlar' },
                            { id: 3, mainCategoryId: 2, code: '02.01', name: 'Motorlar' },
                            { id: 4, mainCategoryId: 3, code: '03.01', name: 'Kağıt Ürünleri' }
                        ];
                        
                        this.materialTypes = [
                            { id: 1, subCategoryId: 1, code: '01.01.01', name: 'Laptoplar' },
                            { id: 2, subCategoryId: 1, code: '01.01.02', name: 'Masaüstü Bilgisayarlar' },
                            { id: 3, subCategoryId: 2, code: '01.02.01', name: 'Akıllı Telefonlar' },
                            { id: 4, subCategoryId: 3, code: '02.01.01', name: 'DC Motorlar' },
                            { id: 5, subCategoryId: 4, code: '03.01.01', name: 'A4 Kağıt' }
                        ];
                        
                        this.suppliers = [
                            { id: 1, shortName: 'ABC Ltd', fullName: 'ABC Limited Şirketi' },
                            { id: 2, shortName: 'XYZ A.Ş.', fullName: 'XYZ Anonim Şirketi' }
                        ];
                        
                        this.materials = [
                            {
                                id: 1,
                                code: '01.01.01.001',
                                name: 'Dell XPS 13',
                                materialTypeId: 1,
                                unit: 'Adet',
                                stockQuantity: 10,
                                price: 35000,
                                minStockLevel: 2,
                                supplierId: 1,
                                description: '13 inç laptop',
                                isActive: true
                            },
                            {
                                id: 2,
                                code: '01.02.01.001',
                                name: 'iPhone 13',
                                materialTypeId: 3,
                                unit: 'Adet',
                                stockQuantity: 5,
                                price: 25000,
                                minStockLevel: 1,
                                supplierId: 2,
                                description: 'Apple telefon',
                                isActive: true
                            },
                            {
                                id: 3,
                                code: '02.01.01.001',
                                name: '12V DC Motor',
                                materialTypeId: 4,
                                unit: 'Adet',
                                stockQuantity: 50,
                                price: 150,
                                minStockLevel: 10,
                                supplierId: 1,
                                description: '12V 3A motor',
                                isActive: true
                            },
                            {
                                id: 4,
                                code: '03.01.01.001',
                                name: 'A4 Kağıt 80gr',
                                materialTypeId: 5,
                                unit: 'Paket',
                                stockQuantity: 100,
                                price: 120,
                                minStockLevel: 20,
                                supplierId: 2,
                                description: '500 sayfa, 80gr',
                                isActive: true
                            }
                        ];
                    },
                    loadSubCategories: function() {
                        if (this.selectedMainCategoryId) {
                            this.selectedSubCategoryId = '';
                            this.currentMaterial.materialTypeId = '';
                            
                            // Normalde bir API call yapılabilir
                            // axios.get('/api/sub-categories?mainCategoryId=' + this.selectedMainCategoryId)
                            //    .then(response => {
                            //        this.filteredSubCategories = response.data;
                            //    });
                        }
                    },
                    loadMaterialTypes: function() {
                        if (this.selectedSubCategoryId) {
                            this.currentMaterial.materialTypeId = '';
                            
                            // Normalde bir API call yapılabilir
                            // axios.get('/api/material-types?subCategoryId=' + this.selectedSubCategoryId)
                            //    .then(response => {
                            //        this.filteredMaterialTypes = response.data;
                            //    });
                        }
                    },
                    getCategoryName: function(material) {
                        const materialType = this.materialTypes.find(mt => mt.id === material.materialTypeId);
                        if (!materialType) return 'Bilinmiyor';
                        
                        const subCategory = this.subCategories.find(sc => sc.id === materialType.subCategoryId);
                        if (!subCategory) return materialType.name;
                        
                        const mainCategory = this.mainCategories.find(mc => mc.id === subCategory.mainCategoryId);
                        if (!mainCategory) return subCategory.name + ' > ' + materialType.name;
                        
                        return mainCategory.name + ' > ' + subCategory.name + ' > ' + materialType.name;
                    },
                    getSupplierName: function(supplierId) {
                        if (!supplierId) return '-';
                        const supplier = this.suppliers.find(s => s.id === supplierId);
                        return supplier ? supplier.shortName : 'Bilinmiyor';
                    },
                    showCreateForm: function() {
                        this.isEditing = false;
                        this.selectedMainCategoryId = '';
                        this.selectedSubCategoryId = '';
                        this.currentMaterial = {
                            id: 0,
                            code: '',
                            name: '',
                            materialTypeId: '',
                            unit: 'Adet',
                            stockQuantity: 0,
                            price: 0,
                            minStockLevel: 0,
                            supplierId: '',
                            description: '',
                            isActive: true
                        };
                        this.materialModal.show();
                    },
                    editMaterial: function(material) {
                        this.isEditing = true;
                        this.currentMaterial = { ...material };
                        
                        // Malzemenin kategori bilgilerini set et
                        const materialType = this.materialTypes.find(mt => mt.id === material.materialTypeId);
                        if (materialType) {
                            const subCategory = this.subCategories.find(sc => sc.id === materialType.subCategoryId);
                            if (subCategory) {
                                this.selectedSubCategoryId = subCategory.id;
                                this.selectedMainCategoryId = subCategory.mainCategoryId;
                            }
                        }
                        
                        this.materialModal.show();
                    },
                    saveMaterial: function() {
                        if (this.isEditing) {
                            // PUT isteği - güncelleme
                            // axios.put('/api/materials/' + this.currentMaterial.id, this.currentMaterial)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.materialModal.hide();
                            //     });
                            
                            // Şimdilik manuel güncelleme
                            const index = this.materials.findIndex(m => m.id === this.currentMaterial.id);
                            if (index !== -1) {
                                this.materials.splice(index, 1, {...this.currentMaterial});
                            }
                        } else {
                            // POST isteği - yeni ekleme
                            // axios.post('/api/materials', this.currentMaterial)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.materialModal.hide();
                            //     });
                            
                            // Şimdilik manuel ekleme
                            // Kod oluşturma - pratik uygulamada backend tarafında yapılmalı
                            const materialType = this.materialTypes.find(mt => mt.id === this.currentMaterial.materialTypeId);
                            if (materialType) {
                                this.currentMaterial.code = materialType.code + '.001';
                            }
                            
                            const newId = Math.max(0, ...this.materials.map(m => m.id)) + 1;
                            this.currentMaterial.id = newId;
                            this.materials.push({...this.currentMaterial});
                        }
                        this.materialModal.hide();
                    },
                    deleteMaterial: function(material) {
                        this.materialToDelete = material;
                        this.deleteModal.show();
                    },
                    confirmDelete: function() {
                        if (this.materialToDelete) {
                            // DELETE isteği
                            // axios.delete('/api/materials/' + this.materialToDelete.id)
                            //     .then(response => {
                            //         this.loadData();
                            //         this.deleteModal.hide();
                            //     });
                            
                            // Şimdilik manuel silme
                            const index = this.materials.findIndex(m => m.id === this.materialToDelete.id);
                            if (index !== -1) {
                                this.materials.splice(index, 1);
                            }
                            this.deleteModal.hide();
                        }
                    },
                    searchMaterials: function() {
                        if (!this.searchQuery.trim()) {
                            this.loadData();
                            return;
                        }
                        
                        // Normalde bir API call yapılır
                        // axios.get('/api/materials/search?q=' + encodeURIComponent(this.searchQuery))
                        //     .then(response => {
                        //         this.materials = response.data;
                        //     });
                        
                        // Şimdilik basit bir client-side arama yapıyoruz
                        this.loadData(); // Önce tüm verileri yükle
                        const query = this.searchQuery.toLowerCase();
                        this.materials = this.materials.filter(m => 
                            m.code.toLowerCase().includes(query) || 
                            m.name.toLowerCase().includes(query)
                        );
                    },
                    filterByCategory: function() {
                        if (this.categoryFilter === '0') {
                            this.loadData();
                            return;
                        }
                        
                        // Tüm verileri yükle
                        this.loadData();
                        
                        // Kategori filtreleme
                        const [type, id] = this.categoryFilter.split('-');
                        const categoryId = parseInt(id);
                        
                        if (type === 'main') {
                            // Ana kategoriye göre filtrele
                            const subCategoryIds = this.subCategories
                                .filter(sc => sc.mainCategoryId === categoryId)
                                .map(sc => sc.id);
                                
                            const materialTypeIds = this.materialTypes
                                .filter(mt => subCategoryIds.includes(mt.subCategoryId))
                                .map(mt => mt.id);
                                
                            this.materials = this.materials.filter(m => materialTypeIds.includes(m.materialTypeId));
                        } else if (type === 'sub') {
                            // Alt kategoriye göre filtrele
                            const materialTypeIds = this.materialTypes
                                .filter(mt => mt.subCategoryId === categoryId)
                                .map(mt => mt.id);
                                
                            this.materials = this.materials.filter(m => materialTypeIds.includes(m.materialTypeId));
                        }
                    }
                }
            });
            app.mount('#materialApp');
        });
    </script>
}
