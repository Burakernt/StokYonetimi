@{
    ViewData["Title"] = "Ana Sayfa";
}
<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet">


<div class="container ">
    <div class="row mb-4">
        <div class="col-12">
            <div class="card2 border-0 " style="margin-top:70px" >
                <div class="card-body">
                    <h1 class="display-4" style="font-weight:500">Envanter Yönetim Sistemi</h1>
                    <p class="lead">Malzeme, tedarikçi ve envanter yönetimi için kapsamlı bir çözüm.</p>
                    <hr style="border: none; border-top: 1px solid black; margin-top: 20px;">

                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm " style="padding:6px;">
                <div class="card-body d-flex flex-column justify-content-center text-lg-start">
                    <h5 class="card-title mt-3">Toplam Tedarikçi</h5>
                    <h2 class="my-2 fw-bold">7</h2> <!-- büyük sayı -->
                    <a href="/Supplier" class="text-decoration-none mt-2" style="font-size: 0.9rem; padding-bottom:6px">Tedarikçileri Yönet</a> <!-- küçük link -->
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm " style="padding:6px;">
                <div class="card-body d-flex flex-column justify-content-center text-lg-start">
                    <h5 class="card-title mt-3">Toplam Malzeme Grubu</h5>
                    <h2 class="my-2 fw-bold">29</h2> <!-- büyük sayı -->
                    <a href="/Supplier" class="text-decoration-none mt-2" style="font-size: 0.9rem; padding-bottom:6px">Malzeme Gruplarını Yönet</a> <!-- küçük link -->
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm " style="padding:6px;">
                <div class="card-body d-flex flex-column justify-content-center text-lg-start">
                    <h5 class="card-title mt-3">Toplam Malzeme</h5>
                    <h2 class="my-2 fw-bold">396</h2> <!-- büyük sayı -->
                    <a href="/Supplier" class="text-decoration-none mt-2" style="font-size: 0.9rem; padding-bottom:6px">Malzemeleri Yönet</a> <!-- küçük link -->
                </div>
            </div>
        </div>


        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm " style="padding:6px;">
                <div class="card-body d-flex flex-column justify-content-center text-lg-start">
                    <h5 class="card-title mt-3">Toplam Müşteri/Ekip</h5>
                    <h2 class="my-2 fw-bold">42</h2> <!-- büyük sayı -->
                    <a href="/Supplier" class="text-decoration-none mt-2" style="font-size: 0.9rem; padding-bottom:6px">Müşteri/Ekipleri Yönet</a> <!-- küçük link -->
                </div>
            </div>
        </div>

    </div>

    <div class="row">
        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm h-100 ">
                <div class="card-body d-flex flex-column text-center">
                    <i class="mdi mdi-truck text-primary" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Tedarikçi Tanımları</h5>
                    <p class="card-text">Tüm tedarikçilerinizi kolaylıkla yönetin.</p>
                    <a href="/Supplier" class="btn btn-outline-dark mt-auto mb-3 mx-auto d-block" style="width: 70%">Görüntüle</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column text-center">
                    <i class="mdi mdi-shape text-success" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Malzeme Grup Tanımları</h5>
                    <p class="card-text">Hiyerarşik malzeme kategorilerini düzenleyin.</p>
                    <a href="/MaterialGroup" class="btn btn-outline-dark mt-auto mb-3 mx-auto d-block" style="width: 70%">Görüntüle</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column text-center ">
                    <i class="mdi mdi-package-variant text-warning" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Malzeme Tanımları</h5>
                    <p class="card-text">Ürün ve malzemelerinizi detaylı bir şekilde yönetin.</p>
                    <a href="/Material" class="btn btn-outline-dark mt-auto mb-3 mx-auto d-block" style="width: 70%">Görüntüle</a>
                </div>
            </div>
        </div>

        <div class="col-md-6 col-lg-3 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column text-center">
                    <i class="mdi mdi-account-group text-info" style="font-size: 3rem;"></i>
                    <h5 class="card-title mt-3">Müşteri/Ekip Tanımları</h5>
                    <p class="card-text">Müşterilerinizi ve ekiplerinizi yönetin.</p>
                    <a href="/CustomerTeam" class="btn btn-outline-dark mt-auto mb-3 mx-auto d-block" style="width: 70%">Görüntüle</a>
                </div>
            </div>
        </div>
    </div>



</div>
<!-- Bootstrap JS Bundle (Popper ile birlikte) -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

<script src="~\lib\vue.global.js"></script>
