@{
    ViewData["Title"] = "Ana Sayfa";
}
<style>

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */
</style>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body>
    <div id="dashboardApp" class="container" v-cloak>

        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-0 mt-5">
                    <div class="card-body">
                        <h1 class="display-4 fw-normal">Envanter Yönetim Sistemi</h1>
                        <p class="lead">Malzeme, tedarikçi ve envanter yönetimi için kapsamlı bir çözüm.</p>
                        <hr />
                    </div>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Card  -->
            <template v-for="card in cards" :key="card.title">
                <div class="col-md-6 col-lg-3 mb-4">
                    <div class="card shadow-sm p-3 h-100">
                        <div class="card-body d-flex flex-column justify-content-center">
                            <h5 class="card-title">{{ card.title }}</h5>
                            <h2 class="my-2 fw-bold">{{ card.count }}</h2>
                            <a :href="card.link" class="text-decoration-none mt-auto">{{ card.linkText }}</a>
                        </div>
                    </div>
                </div>
            </template>
        </div>

        <div class="row">
            <!-- links -->
            <div class="col-md-6 col-lg-3 mb-4" v-for="quick in quickLinks" :key="quick.title">
                <div class="card shadow-sm h-100">
                    <div class="card-body d-flex flex-column text-center">
                        <i :class="quick.icon" style="font-size:3rem"></i>
                        <h5 class="card-title mt-3">{{ quick.title }}</h5>
                        <p class="card-text">{{ quick.text }}</p>
                        <a :href="quick.link" class="btn btn-outline-dark mt-auto mx-auto" style="width:70%">
                            Görüntüle
                        </a>
                    </div>
                </div>
            </div>
        </div>

    </div>

    <script src="~/lib/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script>
        Vue.createApp({
          data() {
            return {
              cards: [
                { title: 'Toplam Tedarikçi', count: 0, link: '/Suppliers', linkText: 'Tedarikçileri Yönet' },
                { title: 'Toplam Malzeme Grubu', count: 0, link: '/MaterialGroup', linkText: 'Grupları Yönet' },
                { title: 'Toplam Malzeme', count: 0, link: '/Materials', linkText: 'Malzemeleri Yönet' },
                { title: 'Toplam Müşteri/Ekip', count: 0, link: '/CustomerTeams', linkText: 'Ekipleri Yönet' },
              ],
              quickLinks: [
                { title: 'Tedarikçi Tanımları', text: 'Tüm tedarikçilerinizi kolaylıkla yönetin.', icon: 'mdi mdi-truck text-primary', link: '/Suppliers' },
                { title: 'Malzeme Grup Tanımları', text: 'Hiyerarşik malzeme kategorilerini düzenleyin.', icon: 'mdi mdi-shape text-success', link: '/MaterialGroup' },
                { title: 'Malzeme Tanımları', text: 'Ürün ve malzemelerinizi detaylı yönetin.', icon: 'mdi mdi-package-variant text-warning', link: '/Materials' },
                { title: 'Müşteri/Ekip Tanımları', text: 'Müşterilerinizi ve ekiplerinizi yönetin.', icon: 'mdi mdi-account-group text-info', link: '/CustomerTeams' },
              ]
            };
          },
          async mounted() {
            
            const [sup, grp, mat, team] = await Promise.all([
              axios.get('/api/SuppliersApi'),
              axios.get('/api/MainCategoriesApi'),
              axios.get('/api/MaterialsApi'),
              axios.get('/api/CustomerTeamsApi')
            ]);
            this.cards[0].count = sup.data.length;
            this.cards[1].count = grp.data.length;
            this.cards[2].count = mat.data.length;
            this.cards[3].count = team.data.length;
          }
        }).mount('#dashboardApp');
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
