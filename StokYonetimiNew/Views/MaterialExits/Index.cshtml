@model IEnumerable<StokYonetimiNew.Models.MaterialExit>
@{
    ViewData["Title"] = "Malzeme/Ürün Çıkışı";
}

<style>
    .stock-error-toast {
        position: fixed;
        bottom: 20px;
        right: 20px;
        background: white;
        color: black;
        border: 1px solid black;
        border-radius: 10px;
        padding: 10px 20px;
        font-size: 14px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.2);
        z-index: 9999;
    }

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */
</style>
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/lib/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
    <link rel="stylesheet" href="https://unpkg.com/vue-select@3.14.2/dist/vue-select.css">
    <script src="https://unpkg.com/vue-select@3.14.2"></script>

</head>
<body>
    <div id="materialOutApp" class="container py-4" v-cloak>
        <div v-if="showStockError" class="stock-error-toast">
            Yeterli stok bulunmuyor
        </div>
        <h2>@ViewData["Title"]</h2>

        <!-- Yeni Çıkış Başlığı  -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="h5 mb-0">Yeni Çıkış</span>
            <button class="btn btn-outline-dark me-2" v-on:click="saveMaterialExits">
                <i class="mdi mdi-content-save"></i> Kaydet
            </button>
        </div>

        <!-- Çıkış Formu -->
        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">
                <div class="row g-2 mb-2">
                    <div class="col-sm-4">
                        <label class="form-label form-label-sm">Tarih</label>
                        <input type="date" class="form-control form-control-sm" v-model="form.date" />
                    </div>
                </div>

                <h6 class="mb-2">Detaylar</h6>
                <div v-for="(item, idx) in form.items" :key="idx" class="row g-2 align-items-end mb-2">
                    <div class="col-sm-5">
                        <label class="form-label form-label-sm">Malzeme/Ürün</label>
                        <select class="form-select form-select-sm" v-model.number="item.materialId">
                            <option :value="null">Seçiniz</option>
                            <option v-for="m in materials" :key="m.id" :value="m.id">
                                {{ m.code }} – {{ m.name }}  <span > ({{ m.unit }})</span>
                            </option>
                        </select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label form-label-sm">Miktar</label>
                        <input type="number"
                               class="form-control form-control-sm"
                               v-model.number="item.quantity"
                               min="1" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label form-label-sm">Müşteri/Ekip</label>
                        <select class="form-select form-select-sm" v-model.number="item.customerTeamId">
                            <option :value="null">Seçiniz</option>
                            <option v-for="t in customerTeams" :key="t.id" :value="t.id">
                                {{ t.department }} – {{ t.teamName }}
                            </option>
                        </select>
                    </div>
                    <div class="col-sm-2 text-end">
                        <button class="btn btn-danger btn-sm" v-on:click="removeItem(idx)">
                            <i class="mdi mdi-minus"></i>
                        </button>
                    </div>
                </div>
                
                <div class="text-center">
                    <button class="btn btn-dark " v-on:click="addItem">
                        <i class="mdi mdi-plus"></i> Satır Ekle
                    </button>
                </div>
            </div>
        </div>

        <!-- Geçmiş Çıkışlar Tablosu -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h6 class="mb-0">Geçmiş Çıkışlar</h6>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Malzeme</th>
                                <th class="text-end">Miktar</th>
                                <th>Müşteri/Ekip</th>
                                <th class="text-center">Sil</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="e in exits" :key="e.id">
                                <td>{{ formatDate(e.date) }}</td>
                                <td>{{ e.material.code }} – {{ e.material.name }} </td>
                                <td class="text-end">{{ e.quantity }}</td>
                                <td>{{ e.customerTeam.department }} – {{ e.customerTeam.teamName }}</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-danger" v-on:click="deleteExit(e.id)">
                                        🗑
                                    </button>
                                </td>
                            </tr>
                            <tr v-if="exits.length === 0">
                                <td colspan="5" class="text-center py-3">Kayıt bulunamadı</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            const app = Vue.createApp({
                data() {
                    return {
                        showStockError: false,
                        materials: [],
                        customerTeams: [],
                        exits: [],
                        form: {
                            date: new Date().toISOString().slice(0,10),
                            items: [{ materialId: null, quantity: 1, customerTeamId: null }]
                        }
                    };
                },
                async mounted() {
                    await this.loadAll();
                },
                methods: {
                    async loadAll() {
                        const [matR, teamR, exitR] = await Promise.all([
                            axios.get('/api/MaterialsApi'),
                            axios.get('/api/CustomerTeamsApi'),
                            axios.get('/api/MaterialExitsApi')
                        ]);
                        this.materials = matR.data;
                        this.customerTeams = teamR.data;
                        this.exits = exitR.data;
                    },
                    formatDate(d) {
                        return new Date(d).toLocaleDateString('tr-TR');
                    },
                    addItem() {
                        this.form.items.push({ materialId: null, quantity: 1, customerTeamId: null });
                    },
                    removeItem(i) {
                        if (this.form.items.length > 1) this.form.items.splice(i,1);
                    },
                               async saveMaterialExits() {
                if (!this.form.date) return alert('Tarih gerekli');
                for (let it of this.form.items) {
                    if (!it.materialId || it.quantity < 1 || !it.customerTeamId) {
                        return alert('Tüm alanları doldurun');
                    }
                    try {
                        await axios.post('/api/MaterialExitsApi', {
                            date: this.form.date,
                            materialId: it.materialId,
                            quantity: it.quantity,
                            customerTeamId: it.customerTeamId
                        });
                    } catch (error) {
                        if (error.response && error.response.status === 400) {
                            this.showStockError = true;
                            setTimeout(() => {
                                this.showStockError = false;
                            }, 3000);
                            return;
                        } else {
                            console.error(error);
                            alert('Bilinmeyen bir hata oluştu');
                            return;
                        }
                    }
                }
                this.form = {
                    date: new Date().toISOString().slice(0,10),
                    items: [{ materialId: null, quantity: 1, customerTeamId: null }]
                };
                await this.loadAll();
                alert('Çıkışlar kaydedildi');
            },
                    async deleteExit(id) {
                        if (!confirm('Silinsin mi?')) return;
                        await axios.delete(`/api/MaterialExitsApi/${id}`);
                        await this.loadAll();
                    }
                }
            })
            app.mount('#materialOutApp');
        </script>
    }
</body>
</html>
