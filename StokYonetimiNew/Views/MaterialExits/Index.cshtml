@model IEnumerable<StokYonetimiNew.Models.MaterialExit>
@{
    ViewData["Title"] = "Malzeme/Ürün Çıkışı";
}
<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />

    <!-- vue-next-select CSS -->
    <link href="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/index.min.css" rel="stylesheet" />

    <!-- SweetAlert2 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css" rel="stylesheet" />

    <style>
        .vue-select {
            display: block;
            width: 100%;
            padding: .375rem .75rem;
            font-size: 1rem;
            line-height: 1.5;
            color: #212529;
            background-color: #fff;
            border: 1px solid #ced4da;
            border-radius: .375rem;
            min-height: calc(1.5em + .75rem + 2px);
            transition: border-color .15s ease-in-out, box-shadow .15s ease-in-out;
        }

            .vue-select:focus {
                border-color: #86b7fe;
                outline: 0;
                box-shadow: 0 0 0 .25rem rgba(13,110,253,.25);
            }
        .stock-error-toast {
            position: fixed;
            bottom: 20px;
            right: 20px;
            background: white;
            color: black;
            border: 1px solid black;
            border-radius: 10px;
            padding: 10px 20px;
            font-size: 14px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.2);
            z-index: 9999;
        }

        .fs-7 {
            font-size: .875rem !important;
        }

        .fs-8 {
            font-size: .75rem !important;
        }

        .btn-outline-dark.active {
            background-color: #212529;
            color: #fff;
        }
    </style>
</head>
<body>
    <div id="materialOutApp" class="container py-4" v-cloak>
        <div v-if="showStockError" class="stock-error-toast">
            Yeterli stok bulunmuyor
        </div>

        <h2>@ViewData["Title"]</h2>

        <!-- Yeni Çıkış -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="h5 mb-0">Yeni Çıkış</span>
            <div>
                <button class="btn btn-outline-dark me-2" @@click="saveMaterialExits">
                    <i class="mdi mdi-content-save"></i>
                    <span v-if="!isEditing">Kaydet</span>
                    <span v-else>Güncelle</span>
                </button>
                <button v-if="isEditing" class="btn btn-outline-secondary" @@click="cancelEdit">
                    Vazgeç
                </button>
            </div>
        </div>

        <!-- Çıkış Formu -->
        <div class="card shadow-sm mb-4">
            <div class="card-body py-3">
                <div class="row g-2 mb-2">
                    <div class="col-sm-4">
                        <label class="form-label ">Tarih</label>
                        <input type="date"
                               class="form-control form-control-sm"
                               v-model="form.date" />
                    </div>
                </div>



                <h6 class="mb-2">Detaylar</h6>
                <div v-for="(item, idx) in form.items" :key="idx" class="row g-2 align-items-end mb-2">
                    <div class="col-sm-5">
                        <label class="form-label">Malzeme/Ürün</label>
                        <vue-next-select class="vue-select"
                                         v-model="item.material"
                                         :options="filteredExitMaterials"
                                         label-by="name"
                                         value-by="id"
                                         placeholder="Malzeme seçin..."
                                         searchable
                                         @@search-change="onExitSearchChange">
                            <template #dropdown-item="{ option }">
                                {{ option.code }} – {{ option.name }}
                            </template>
                            <template #tag="{ option }">
                                {{ option.code }} – {{ option.name }}
                            </template>
                        </vue-next-select>
                    </div>
                    <div class="col-sm-2">
                        <label class="form-label ">Miktar</label>
                        <input type="number"
                               class="form-control form-control-sm"
                               v-model.number="item.quantity"
                               min="1" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label ">Müşteri/Ekip</label>
                        <select class="form-select form-select-sm"
                                v-model.number="item.customerTeamId">
                            <option :value="null">Seçiniz</option>
                            <option v-for="t in customerTeams" :key="t.id" :value="t.id">
                                {{ t.department }} – {{ t.teamName }}
                            </option>
                        </select>
                    </div>
                    <div class="col-sm-2 text-end">
                        <button class="btn btn-danger btn-sm" @@click="removeItem(idx)">
                            <i class="mdi mdi-minus"></i>
                        </button>
                    </div>
                </div>

                <div class="text-center">
                    <button class="btn btn-dark" @@click="addItem">
                        <i class="mdi mdi-plus"></i> Satır Ekle
                    </button>
                </div>
            </div>
        </div>

        <!-- Geçmiş Çıkışlar -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-light"><h6 class="mb-0">Geçmiş Çıkışlar</h6></div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 fs-7">
                        <thead class="table-light">
                            <tr>
                                <th>Tarih</th>
                                <th>Malzeme</th>
                                <th class="text-end">Miktar</th>
                                <th>Müşteri/Ekip</th>
                                <th class="text-center fs-8" style="width:80px">Düzenle</th>
                                <th class="text-center fs-8">Sil</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="e in pagedExits" :key="e.id">
                                <td>{{ formatDate(e.date) }}</td>
                                <td>{{ e.material.code }} – {{ e.material.name }}</td>
                                <td class="text-end">{{ e.quantity }}</td>
                                <td>{{ e.customerTeam.department }} – {{ e.customerTeam.teamName }}</td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-light me-1" @@click="editExit(e)">
                                        <i class="mdi mdi-pencil"></i>
                                    </button>
                                </td>
                                <td class="text-center">
                                    <button class="btn btn-sm btn-danger" @@click="deleteExit(e.id)">
                                        <i class="mdi mdi-delete"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr v-if="exits.length===0">
                                <td colspan="6" class="text-center py-3">Kayıt bulunamadı</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- Pagination Controls -->
        <div class="d-flex justify-content-between align-items-center">
            <div>
                <label>
                    Sayfa Başı:
                    <select v-model.number="perPage" @@change="changePerPage"
                            class="form-select form-select-sm d-inline-block" style="width:auto">
                        <option v-for="opt in perPageOptions" :key="opt" :value="opt">{{ opt }}</option>
                    </select>
                </label>
            </div>
            <div>
                <button v-for="p in pages" :key="p" class="btn btn-outline-dark btn-sm mx-1"
                        :class="{ 'active': p===currentPage }" @@click="changePage(p)">
                    {{ p }}
                </button>
            </div>
        </div>
    </div>

    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
        <script src="~/lib/vue.global.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/vue-next-select.iife.prod.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            const app = Vue.createApp({
              data() {
                return {
                  exitSearchQuery: '',
                  showStockError: false,
                  materials: [],
                  customerTeams: [],
                  exits: [],
                  currentPage: 1,
                  perPageOptions: [5,10,20,50],
                  perPage: 10,
                  isEditing: false,
                  editingId: null,
                  form: {
                    date: new Date().toISOString().slice(0,10),
                    items: [{ material: null, quantity:1, customerTeamId: null }]
                  }
                };
              },
              computed: {
                filteredExitMaterials() {
                  const q = this.exitSearchQuery.toLowerCase();
                  return this.materials.filter(m =>
                    m.name.toLowerCase().includes(q) ||
                    m.code.toLowerCase().includes(q)
                  );
                },
                sortedExits() {
                  return [...this.exits].sort((a,b) =>
                    new Date(b.date) - new Date(a.date)
                  );
                },
                totalPages() {
                  return Math.ceil(this.sortedExits.length/this.perPage) || 1;
                },
                pages() {
                  return Array.from({ length:this.totalPages }, (_,i) => i+1);
                },
                pagedExits() {
                  const start = (this.currentPage-1)*this.perPage;
                  return this.sortedExits.slice(start, start+this.perPage);
                }
              },
              methods: {
                onExitSearchChange(val) {
                  this.exitSearchQuery = val;
                },
                async fetchLookups() {
                  const [matR, teamR] = await Promise.all([
                    axios.get('/api/MaterialsApi'),
                    axios.get('/api/CustomerTeamsApi')
                  ]);
                  this.materials = matR.data;
                  this.customerTeams = teamR.data;
                },
                async fetchExits() {
                  const res = await axios.get('/api/MaterialExitsApi');
                  this.exits = res.data;
                  if (this.currentPage > this.totalPages) this.currentPage = this.totalPages;
                },
                formatDate(d) {
                  return new Date(d).toLocaleDateString('tr-TR');
                },
                addItem() {
                  this.form.items.push({ material: null, quantity:1, customerTeamId: null });
                },
                removeItem(i) {
                  if (this.form.items.length > 1) this.form.items.splice(i,1);
                },
                async saveMaterialExits() {
                  if (!this.form.date) {
                    await Swal.fire({ icon:'warning', title:'Eksik Bilgi', text:'Tarih gerekli.' });
                    return;
                  }
                  for (const it of this.form.items) {
                    if (!it.material || it.quantity < 1 || !it.customerTeamId) {
                      await Swal.fire({ icon:'warning', title:'Eksik Bilgi', text:'Tüm alanları doldurun.' });
                      return;
                    }
                    const payload = {
                      date: this.form.date,
                      materialId: it.material.id,
                      quantity: it.quantity,
                      customerTeamId: it.customerTeamId
                    };
                    try {
                      if (this.isEditing) {
                        await axios.put(`/api/MaterialExitsApi/${this.editingId}`, { id: this.editingId, ...payload });
                      } else {
                        await axios.post('/api/MaterialExitsApi', payload);
                      }
                    } catch (err) {
                      if (err.response?.status === 400) {
                        this.showStockError = true;
                        setTimeout(() => this.showStockError = false, 3000);
                        return;
                      }
                      console.error(err);
                      await Swal.fire({ icon:'error', title:'Hata', text:'Beklenmeyen bir hata oluştu.' });
                      return;
                    }
                  }
                  this.cancelEdit();
                  await this.fetchExits();
                  await Swal.fire({ icon:'success', title: this.isEditing ? 'Güncelleme Tamamlandı' : 'Kaydetme Tamamlandı', timer:1500, showConfirmButton:false });
                },
                editExit(e) {
                  this.isEditing = true;
                  this.editingId = e.id;
                  this.form.date = e.date.slice(0,10);
                  this.form.items = [{
                    material: e.material,
                    quantity: e.quantity,
                    customerTeamId: e.customerTeamId
                  }];
                  window.scrollTo({ top:0, behavior:'smooth' });
                },
                cancelEdit() {
                  this.isEditing = false;
                  this.editingId = null;
                  this.form = {
                    date: new Date().toISOString().slice(0,10),
                    items: [{ material: null, quantity:1, customerTeamId: null }]
                  };
                },
                async deleteExit(id) {
                  const res = await Swal.fire({
                    title:'Emin misiniz?',
                    text:'Bu kaydı silmek istediğinize emin misiniz?',
                    icon:'warning',
                    showCancelButton:true,
                    confirmButtonText:'Evet, sil',
                    cancelButtonText:'Hayır'
                  });
                  if (!res.isConfirmed) return;
                  await axios.delete(`/api/MaterialExitsApi/${id}`);
                  await this.fetchExits();
                  await Swal.fire({ icon:'success', title:'Silindi', timer:1200, showConfirmButton:false });
                },
                changePage(p) {
                  if (p >= 1 && p <= this.totalPages) this.currentPage = p;
                },
                changePerPage() {
                  this.currentPage = 1;
                }
              },
              async mounted() {
                await this.fetchLookups();
                await this.fetchExits();
              }
            });
            app.component('vue-next-select', VueNextSelect);
            app.mount('#materialOutApp');
        </script>
    }
</body>
</html>
