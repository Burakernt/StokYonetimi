@{
    ViewData["Title"] = "Sistem Tanımları - Ölçü Birimleri";
    Layout = "_Layout";
}
<div id="unitsApp" class="container py-4" v-cloak>
    <h2>@ViewData["Title"]</h2>
    <div class="mb-3 text-end">
        <button class="btn btn-dark" @@click="openForm()">
            <i class="mdi mdi-plus"></i> Yeni Ölçü Birimi
        </button>
    </div>

    <div class="card mb-4">
        <div class="card-body p-0">
            <table class="table mb-0">
                <thead class="table-light">
                    <tr><th>Ad</th><th class="text-end">İşlemler</th></tr>
                </thead>
                <tbody>
                    <tr v-for="u in units" :key="u.id">
                        <td>{{ u.name }}</td>
                        <td class="text-end">
                            <button class="btn btn-sm btn-light me-1" @@click="openForm(u)">
                                <i class="mdi mdi-pencil"></i>
                            </button>
                            <button class="btn btn-sm btn-danger" @@click="confirmDelete(u)">
                                <i class="mdi mdi-delete"></i>
                            </button>
                        </td>
                    </tr>
                    <tr v-if="!units.length">
                        <td colspan="2" class="text-center py-3">Hiç kayıt yok</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="unitModal" tabindex="-1">
        <div class="modal-dialog">
            <form class="modal-content" v-on:submit.prevent="save">
                <div class="modal-header">
                    <h5 class="modal-title">{{ editing ? 'Düzenle' : 'Yeni Birim' }}</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Ad *</label>
                        <input v-model="current.name"
                               class="form-control"
                               maxlength="50"
                               required />
                    </div>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Delete Confirm -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Silme Onayı</h5>
                    <button class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>“{{ current.name }}” silinsin mi?</p>
                </div>
                <div class="modal-footer">
                    <button class="btn btn-secondary" data-bs-dismiss="modal">Hayır</button>
                    <button class="btn btn-danger" @@click="remove()">Evet</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/lib/vue.global.js"></script>
    <script>
        const app = Vue.createApp({
          data(){ return {
            units: [],
            current: { id:0, name:'' },
            editing: false,
            modals: { form:null, del:null }
          }},
          async mounted(){
            this.modals.form = new bootstrap.Modal(document.getElementById('unitModal'));
            this.modals.del  = new bootstrap.Modal(document.getElementById('deleteModal'));
            await this.load();
          },
          methods: {
            async load(){
              this.units = (await axios.get('/api/MeasurementUnitsApi')).data;
            },
            openForm(u=null){
              this.editing = !!u;
              this.current = u ? {...u} : { id:0, name:'' };
              this.modals.form.show();
            },
            async save(){
              if(this.editing){
                await axios.put(`/api/MeasurementUnitsApi/${this.current.id}`, this.current);
              } else {
                await axios.post('/api/MeasurementUnitsApi', this.current);
              }
              this.modals.form.hide();
              await this.load();
            },
            confirmDelete(u){
              this.current = u;
              this.modals.del.show();
            },
            async remove(){
              await axios.delete(`/api/MeasurementUnitsApi/${this.current.id}`);
              this.modals.del.hide();
              await this.load();
            }
          }
        }).mount('#unitsApp');
    </script>
}
