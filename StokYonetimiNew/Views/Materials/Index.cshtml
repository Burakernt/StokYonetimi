@model IEnumerable<StokYonetimiNew.Models.Material>
@{
    ViewData["Title"] = "Malzeme/Ürün Tanımları";
}
<style>

    .fs-7 {
        font-size: 0.875rem !important;
    }
    /* 14px */
    .fs-8 {
        font-size: 0.75rem !important;
    }
    /* 12px */

    .vue-select {
        height: calc(2.5rem + 2px); 
        padding: 0.375rem 0.75rem;
        border: 1px solid #ced4da;
        border-radius: 0.375rem;
        font-size: 1rem;
        line-height: 1.5;
        background-color: #fff;
    }

        .vue-select .vue-select-search-input {
            font-size: 1rem;
        }

        .vue-select .vue-select-arrow {
            top: 50%;
            right: 1rem;
            transform: translateY(-50%);
        }
</style>



<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <script src="~/lib/vue.global.js"></script>
    <script>
        window.Vue = Vue; 
    </script>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/index.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/vue-next-select@2.10.5/dist/vue-next-select.iife.prod.js"></script>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>

</head>
<body>
    <div id="materialApp" class="container py-4" v-cloak>
        <h2>@ViewData["Title"]</h2>

        <!-- Arama ve Filtreleme -->
        <div class="row mb-4 align-items-center" style="margin-top:50px">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-dark">
                        <i class="mdi mdi-magnify"></i>
                    </span>
                    <input type="text"
                           class="form-control form-control-sm border-dark"
                           v-model="searchQuery"
                           placeholder="Malzeme ara..."
                           v-on:keyup.enter="searchMaterials"
                           style="padding-top:12px; padding-bottom:12px; font-weight:600" />
                    <button class="btn btn-outline-dark btn-sm"
                            type="button"
                            v-on:click="searchMaterials">
                        Ara
                    </button>
                </div>
            </div>
            <div class="col-md-4">
                <select class="form-select form-select-sm border-dark"
                        v-model="categoryFilter"
                        v-on:change="filterByCategory"
                        style="padding-top:12px; padding-bottom:12px; font-weight:600">
                    <option value="0">Tüm Kategoriler</option>
                    <optgroup label="Ana Kategoriler">
                        <option v-for="c in mainCategories" :key="'main-'+c.id" :value="'main-'+c.id">
                            {{ c.code }} - {{ c.name }}
                        </option>
                    </optgroup>
                    <optgroup label="Alt Kategoriler">
                        <option v-for="s in subCategories" :key="'sub-'+s.id" :value="'sub-'+s.id">
                            {{ s.code }} - {{ s.name }}
                        </option>
                    </optgroup>
                </select>
            </div>
            <div class="col-md-4 text-end">
                <button class="btn btn-dark"
                        style="padding-top:12px; padding-bottom:12px; font-weight:600"
                        v-on:click="showCreateForm">
                    <i class="mdi mdi-plus"></i> Yeni Malzeme
                </button>
            </div>
        </div>

        <!-- Malzeme Tablosu -->
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h4 class="mb-0">Malzeme Listesi</h4>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Kod</th>
                                <th>Malzeme Adı</th>
                                <th>Kategori</th>

                                <th>Tedarikçi</th>
                                <th>Durum</th>
                                <th>İşlemler</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr v-for="m in pagedMaterials" :key="m.id">
                                <td><span class="badge bg-secondary">{{ m.code }}</span></td>
                                <td>{{ m.name }}</td>
                                <td>{{ getCategoryName(m) }}</td>
                                <td>{{ m.unit }}</td>
                                <td>
                                    <span :class="m.isActive ? 'badge bg-success' : 'badge bg-danger'">
                                        {{ m.isActive ? 'Aktif' : 'Pasif' }}
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-light border border-dark rounded-2 me-1"
                                            v-on:click="editMaterial(m)">
                                        <i class="mdi mdi-pencil"></i>
                                    </button>
                                    <button class="btn btn-sm btn-danger border border-dark rounded-2"
                                            v-on:click="deleteMaterial(m)">
                                        <i class="mdi mdi-delete"></i>
                                    </button>
                                </td>
                            </tr>
                            <tr v-if="materials.length === 0">
                                <td colspan="8" class="text-center py-3">Hiç malzeme bulunamadı</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
        <!-- pagination controls -->
        <div class="d-flex justify-content-between align-items-center mt-3">
            <div>
                <label>
                    sayfa başı
                    <select v-model.number="perPage" v-on:change="changePerPage"
                            class="form-select form-select-sm d-inline-block"
                            style="width:auto">
                        <option v-for="opt in perPageOptions" :key="opt" :value="opt">
                            {{ opt }}
                        </option>
                    </select>
                </label>
            </div>
            <div>
                <button v-for="p in pages" :key="p"
                        class="btn btn-outline-dark btn-sm mx-1"
                        :class="{ 'active': p === currentPage }"
                        v-on:click="changePage(p)">
                    {{ p }}
                </button>
            </div>
        </div>

        <!-- Malzeme Form Modal -->
        <div class="modal fade" id="materialModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">{{ isEditing ? 'Malzeme Düzenle' : 'Yeni Malzeme Ekle' }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <form v-on:submit.prevent="saveMaterial">
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Ana Kategori *</label>
                                    <select class="form-select"
                                            v-model="selectedMainCategoryId"
                                            v-on:change="loadSubCategories"
                                            required>
                                        <option value="">Seçiniz</option>
                                        <option v-for="c in mainCategories" :key="c.id" :value="c.id">
                                            {{ c.code }} - {{ c.name }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Alt Kategori *</label>
                                    <select class="form-select"
                                            v-model="selectedSubCategoryId"
                                            v-on:change="loadMaterialTypes"
                                            required
                                            :disabled="!selectedMainCategoryId">
                                        <option value="">Seçiniz</option>
                                        <option v-for="s in filteredSubCategories" :key="s.id" :value="s.id">
                                            {{ s.code }} - {{ s.name }}
                                        </option>
                                    </select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label">Malzeme Tipi *</label>
                                    <select class="form-select"
                                            v-model="currentMaterial.materialTypeId"
                                            required
                                            :disabled="!selectedSubCategoryId"
                                            v-on:change="generateMaterialCode">
                                        <option value="">Seçiniz</option>
                                        <option v-for="t in filteredMaterialTypes" :key="t.id" :value="t.id">
                                            {{ t.code }} - {{ t.name }}
                                        </option>
                                    </select>
                                </div>
                            </div>
                            <div class="row mb-3">
                                <div class="col-md-4">
                                    <label class="form-label">Malzeme Kodu *</label>
                                    <input type="text"
                                           class="form-control"
                                           v-model="currentMaterial.code"
                                           required
                                           :readonly="true" />
                                </div>
                                <div class="col-md-8">
                                    <label class="form-label">Malzeme Adı *</label>
                                    <input type="text"
                                           class="form-control"
                                           v-model="currentMaterial.name"
                                           required />
                                </div>
                            </div>
                            <div class="row mb-3">

                                <div class="col-md-4">
                                    <label class="form-label">Ölçü Birimi *</label>
                                    <vue-next-select v-model="currentMaterial.unit"
                                                     :options="units"
                                                     label-key="name"
                                                     value-key="name"
                                                     placeholder="Birimi seçin"
                                                     class="vue-select" />

                                    <template #dropdown-item="{ option }">
                                        {{ option.name }}
                                    </template>
                                    <template #tag="{ option }">
                                        {{ option.name }}
                                    </template>
                                    </vue-next-select>
                                </div>

                            </div>
                            <div class="mb-3 text-end">
                                <button type="button" class="btn btn-secondary me-2" data-bs-dismiss="modal">İptal</button>
                                <button type="submit" class="btn btn-primary">Kaydet</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        <!-- Silme Onay Modal -->
        <div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Malzeme Sil</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>Bu malzemeyi silmek istediğinize emin misiniz?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="button" class="btn btn-danger" v-on:click="confirmDelete">Evet, Sil</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @section Scripts {
        <script>
            const app = Vue.createApp({
                data() {
                    return {
                        materials: [],
                        mainCategories: [],
                        subCategories: [],
                        materialTypes: [],
                        suppliers: [],
                        units: [],
                        currentMaterial: {
                            id: 0,
                            code: '',
                            name: '',
                            materialTypeId: 0,
                            stockQuantity: 0,
                            price: 0,
                            unit: null,
                            minStockLevel: 0,
                            supplierId: 0,
                            description: '',
                            isActive: true
                        },
                        selectedMainCategoryId: null,
                        selectedSubCategoryId: null,
                        isEditing: false,
                        materialModal: null,
                        deleteModal: null,
                        searchQuery: '',
                        categoryFilter: '0',
                        currentPage: 1,
                        perPageOptions: [5, 10, 20, 50],
                        perPage: 10
                                };
                },
                computed: {
                              totalPages() {
              return Math.ceil(this.materials.length / this.perPage) || 1
            },
            pages() {
              return Array.from({ length: this.totalPages }, (_, i) => i + 1)
            },
            pagedMaterials() {
              const start = (this.currentPage - 1) * this.perPage
              return this.materials.slice(start, start + this.perPage)
            },
                              filteredSubCategories() {
                        return this.subCategories.filter(sc =>
                            sc.mainCategoryId == this.selectedMainCategoryId
                        );
                    },
                    filteredMaterialTypes() {
                        return this.materialTypes.filter(mt =>
                            mt.subCategoryId == this.selectedSubCategoryId
                        );
                    }
                },
                async mounted() {
                    await this.loadAll();
                    this.$nextTick(() => {
                        this.materialModal = new bootstrap.Modal(document.getElementById('materialModal'));
                        this.deleteModal   = new bootstrap.Modal(document.getElementById('deleteConfirmModal'));
                    });
                },
                methods: {
                              changePage(p) {
              if (p >= 1 && p <= this.totalPages) {
                this.currentPage = p
              }
            },
            changePerPage() {
              this.currentPage = 1
            },
                               async loadAll() {
              const [mains, subs, types, sups, mats, ums] = await Promise.all([
                axios.get('/api/MainCategoriesApi'),
                axios.get('/api/SubCategoriesApi'),
                axios.get('/api/ProductTypesApi'),
                axios.get('/api/SuppliersApi'),
                axios.get('/api/MaterialsApi'),
                axios.get('/api/MeasurementUnitsApi')
              ]);
              this.mainCategories = mains.data;
              this.subCategories  = subs.data;
              this.materialTypes  = types.data;
              this.suppliers      = sups.data;
              this.materials      = mats.data;
              this.units          = ums.data;

              // pagination sayfa sınır kontrolü
              if (this.currentPage > this.totalPages) {
                this.currentPage = this.totalPages;
              }
            },
                    showCreateForm() {
                        this.isEditing = false;
                        this.selectedMainCategoryId = null;
                        this.selectedSubCategoryId = null;
                        this.currentMaterial = {
                            id: 0,
                            code: '',
                            name: '',
                            materialTypeId: 0,
                            unit: 'Adet',
                            stockQuantity: 0,
                            price: 0,
                            minStockLevel: 0,
                            supplierId: 0,
                            description: '',
                            isActive: true
                        };
                        this.materialModal.show();
                    },
                    editMaterial(m) {
                        this.isEditing = true;
                        this.currentMaterial = { ...m };
                        const mt = this.materialTypes.find(x => x.id == m.materialTypeId);
                        this.selectedSubCategoryId  = mt?.subCategoryId;
                        const sc = this.subCategories.find(x => x.id == mt?.subCategoryId);
                        this.selectedMainCategoryId = sc?.mainCategoryId;
                        this.materialModal.show();
                    },
                    generateMaterialCode() {
                        const prefix = this.materialTypes.find(x => x.id == this.currentMaterial.materialTypeId)?.code;
                        if (!prefix) {
                            this.currentMaterial.code = '';
                            return;
                        }
                        const existingSeq = this.materials
                            .filter(m => m.materialTypeId == this.currentMaterial.materialTypeId)
                            .map(m => {
                                const parts = m.code.split('-');
                                return parseInt(parts[1], 10);
                            })
                            .filter(n => !isNaN(n));
                        const next = existingSeq.length ? Math.max(...existingSeq) + 1 : 1;
                        const padded = String(next).padStart(3, '0');
                        this.currentMaterial.code = `${prefix}-${padded}`;
                    },
                                async saveMaterial() {
              const payload = {
                ...this.currentMaterial,
                unit: typeof this.currentMaterial.unit === 'object'
                      ? this.currentMaterial.unit.name
                      : this.currentMaterial.unit
              };

              if (this.isEditing) {
                await axios.put(
                  `/api/MaterialsApi/${payload.id}`,
                  payload
                );
              } else {
                await axios.post(
                  '/api/MaterialsApi',
                  payload
                );
              }

              this.materialModal.hide();
              await this.loadAll();
            },
                    deleteMaterial(m) {
                        this.currentMaterial = m;
                        this.deleteModal.show();
                    },
                    async confirmDelete() {
                        await axios.delete(
                            `/api/MaterialsApi/${this.currentMaterial.id}`
                        );
                        this.deleteModal.hide();
                        await this.loadAll();
                    },
                    getCategoryName(m) {
                        const mt = this.materialTypes.find(x => x.id == m.materialTypeId);
                        const sc = this.subCategories.find(x => x.id == mt?.subCategoryId);
                        const mc = this.mainCategories.find(x => x.id == sc?.mainCategoryId);
                        return `${mc?.name} > ${sc?.name} > ${mt?.name}`;
                    },
                    getSupplierName(id) {
                        const s = this.suppliers.find(x => x.id == id);
                        return s?.shortName ?? '-';
                    },
                    searchMaterials() {
                        if (!this.searchQuery.trim()) {
                            this.loadAll();
                            return;
                        }
                        const q = this.searchQuery.toLowerCase();
                        this.materials = this.materials.filter(m =>
                            m.code.toLowerCase().includes(q) ||
                            m.name.toLowerCase().includes(q)
                        );
                        this.currentPage = 1
                    },
                    filterByCategory() {
                        if (this.categoryFilter === '0') {
                            this.loadAll();
                            return;
                        }
                        const [type, id] = this.categoryFilter.split('-');
                        const cid = parseInt(id);
                        if (type === 'main') {
                            const subIds = this.subCategories
                                .filter(sc => sc.mainCategoryId === cid)
                                .map(sc => sc.id);
                            this.materials = this.materials.filter(m =>
                                subIds.includes(
                                    this.materialTypes.find(mt => mt.id == m.materialTypeId)
                                      ?.subCategoryId
                                )
                            );
                        } else {
                            this.materials = this.materials.filter(m =>
                                this.materialTypes.find(mt =>
                                    mt.subCategoryId === cid && mt.id == m.materialTypeId
                                )
                            );
                        }
                        this.currentPage = 1
                    }
                }

            });
            app.component('vue-next-select', window.VueNextSelect);
            app.mount('#materialApp');
        </script>
    }
</body>
</html>
