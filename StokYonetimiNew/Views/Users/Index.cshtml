@{
    ViewData["Title"] = "Kullanıcı Yönetimi";
    Layout = "_Layout";
}

<div id="userApp" class="container py-4" v-cloak>
  <h2>@ViewData["Title"]</h2>

  <div class="mb-4 d-flex justify-content-between">
    <span class="h5 mb-0">Kayıtlı Kullanıcılar</span>
    <button class="btn btn-dark btn-sm" @@click="showUserForm()">
      <i class="mdi mdi-plus"></i> Yeni Kullanıcı
    </button>
  </div>

  <div class="card shadow-sm mb-4">
    <div class="card-body p-0">
      <table class="table table-hover mb-0 fs-7">
        <thead class="table-light">
          <tr>
            <th>Kullanıcı Adı</th>
            <th>Rol</th>
            <th class="text-end">İşlemler</th>
          </tr>
        </thead>
        <tbody>
          <tr v-for="u in users" :key="u.id">
            <td>{{ u.username }}</td>
                        <td>{{ getRoleName(u.role) }}</td>
            <td class="text-end">
                            <button class="btn btn-sm btn-light border-dark me-1" v-on:click="showUserForm(u)">
                <i class="mdi mdi-pencil"></i>
              </button>
                            <button class="btn btn-sm btn-danger border-dark" v-on:click="confirmDelete(u)">
                <i class="mdi mdi-delete"></i>
              </button>
            </td>
          </tr>
          <tr v-if="!users.length">
            <td colspan="3" class="text-center py-3">Henüz kullanıcı yok</td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Kullanıcı Modal -->
  <div class="modal fade" id="userModal" tabindex="-1">
    <div class="modal-dialog">
            <form class="modal-content" v-on:submit.prevent="saveUser">
                <div class="modal-header">
          <h5 class="modal-title">{{ editing ? "Kullanıcı Düzenle" : "Yeni Kullanıcı" }}</h5>
          <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <div class="mb-3">
            <label class="form-label">Kullanıcı Adı *</label>
            <input v-model="current.username" class="form-control" required maxlength="100" />
          </div>
          <div class="mb-3">
            <label class="form-label">
              Parola {{ editing ? "(Değiştirmek için doldurun)" : "*" }}
            </label>
            <input type="password" v-model="current.password" class="form-control" :required="!editing" />
          </div>
          <div class="mb-3">
            <label class="form-label">Rol *</label>
            <select v-model="current.role" class="form-select" required>
              <option :value="null">Seçiniz</option>
              

                            <option :value="1">Tanımlamalar/Veri Girişi/Raporlar</option>        <!-- UserRole.Admin -->
                            <option :value="2">Raporlar</option>     <!-- UserRole.Reporter -->
                            <option :value="0">Yetkisiz Kullanıcı</option>         <!-- UserRole.None -->
            </select>
          </div>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">İptal</button>
                    <button type="submit" class="btn btn-primary">Kaydet</button>
                </div>
      </form>
    </div>
  </div>

  <!-- Silme Onayı Modal -->
  <div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
      <div class="modal-content">
        <div class="modal-header">
          <h5 class="modal-title">Silme Onayı</h5>
          <button class="btn-close" data-bs-dismiss="modal"></button>
        </div>
        <div class="modal-body">
          <p>“{{ current.username }}” kullanıcısını silmek istediğinize emin misiniz?</p>
        </div>
        <div class="modal-footer">
          <button class="btn btn-secondary" data-bs-dismiss="modal">Hayır</button>
                    <button class="btn btn-danger" v-on:click="deleteUser">Evet, Sil</button>
        </div>
      </div>
    </div>
  </div>
</div>

@section Scripts {
  <script src="https://cdn.jsdelivr.net/npm/axios/dist/axios.min.js"></script>
    <script src="~/lib/vue.global.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"></script>


  <script>
    const app = Vue.createApp({
      data() {
        return {
          users: [],
          current: { id:0, username:'', password:'', role:null },
          editing: false,
          modals: { user:null, del:null }
        };
      },
      async mounted() {
        axios.defaults.withCredentials = true
        this.modals.user = new bootstrap.Modal(document.getElementById('userModal'));
        this.modals.del  = new bootstrap.Modal(document.getElementById('deleteModal'));
        await this.loadUsers();
      },
      methods: {
                  getRoleName(role) {
          switch(role) {
            case 1: return "Tanımlamalar / Veri Girişi / Raporlar";
            case 2: return "Raporlar";
            case 0: return "Yetkisiz Kullanıcı";
            default: return "Bilinmeyen";
          }
        },
        async loadUsers() {
          this.users = (await axios.get('/api/UsersApi')).data;
        },
        showUserForm(u = null) {
          this.editing = !!u;
          this.current = u
            ? { id: u.id, username: u.username, password:'', role: u.role }
            : { id:0, username:'', password:'', role:null };
          this.modals.user.show();
        },
              async saveUser() {
        
          try {
            const dto = {
              Username: this.current.username,
              Role: this.current.role,
              Password: this.current.password
            };
            if (this.editing) {
              await axios.put(`/api/UsersApi/${this.current.id}`, dto);
            } else {
              await axios.post('/api/UsersApi', dto);
            }
            this.modals.user.hide();
            await this.loadUsers();
          } catch (err) {
            console.error(err);
            alert(err.response?.data || err.message);
          }
        },
        confirmDelete(u) {
          this.current = u;
          this.modals.del.show();
        },
        async deleteUser() {
          await axios.delete(`/api/UsersApi/${this.current.id}`);
          this.modals.del.hide();
          await this.loadUsers();
        }
      }
    }).mount('#userApp');
  </script>
}
